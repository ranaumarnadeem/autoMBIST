#!/usr/bin/env bash
# Auto-generated by autombist -- compile and run the self-checking {{ what }}
# for {{ top }} with Icarus Verilog.
#
{% if default_model %}
#   bash {{ script }} [<memory model .v> [more Verilog sources...]]
#
# With no arguments the generated behavioral model of the memory ({{ default_model }}) is
# used. It is idealized: fault-free, no timing checks, contents power up unknown. To use
# the memory's own simulation model (module {{ memory_name }}), e.g. the Verilog model
# OpenRAM writes with the macro, pass it: everything on the command line is compiled
# instead of the generated model.
{% elif model_required %}
#   bash {{ script }} <memory model .v> [more Verilog sources...]
#
# <memory model .v> is the memory's own simulation model (module
# {{ memory_name }}), e.g. the Verilog model OpenRAM writes with the macro.
{% else %}
#   bash {{ script }} [more Verilog sources...]
#
# The simulated netlist already contains the memory ({{ memory_name }}).
{% endif %}
# Exit status: 0 on PASS; non-zero on FAIL, timeout or a compile error.
# Optional environment: IVERILOG, VVP, BUILD (default: a build/ directory next
# to this script){% if timeout_define %}, MBIST_MAX_CYCLES (the timeout, in clk cycles){% endif %}.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="$(cd "$HERE/{{ out_rel }}" && pwd)"
{% if default_model %}
if [ "$#" -eq 0 ]; then
    echo "note: no memory model given; using the generated behavioral model {{ default_model }}" >&2
    set -- "$HERE/{{ default_model }}"
fi
{% elif model_required %}
if [ "$#" -lt 1 ]; then
    echo "usage: $0 <memory model .v> [more Verilog sources...]" >&2
    exit 2
fi
{% endif %}
IVERILOG="${IVERILOG:-iverilog}"
VVP="${VVP:-vvp}"
BUILD="${BUILD:-$HERE/build}"
DEFINES=()
{% if timeout_define %}
if [ -n "${MBIST_MAX_CYCLES:-}" ]; then
    DEFINES+=("-DMBIST_MAX_CYCLES=$MBIST_MAX_CYCLES")
fi
{% endif %}

mkdir -p "$BUILD"
"$IVERILOG" -g2012 ${DEFINES[@]+"${DEFINES[@]}"} -s {{ tb_module }} -o "$BUILD/{{ tb_module }}.vvp" \
    "$HERE/{{ tb_file }}" \
{% for s in sources %}
    "$OUT/{{ s }}" \
{% endfor %}
    "$@"
{% for f in data_files %}
cp "$HERE/{{ f }}" "$BUILD/{{ f }}"
{% endfor %}
cd "$BUILD"
"$VVP" -n "{{ tb_module }}.vvp"
