`timescale 1ns/1ps

{% set has_redundancy = redundancy is defined and redundancy.num_spare_rows > 0 %}
{% set has_onchip_selfrepair = has_redundancy and redundancy.onchip_selfrepair %}
{% set has_onchip_repair_persistence = has_onchip_selfrepair and redundancy.onchip_repair_persistence %}
{% set mode_signal = "effective_test_mode" if has_onchip_selfrepair else "test_mode" %}
{% set start_signal = "effective_bist_start" if has_onchip_selfrepair else "bist_start && test_mode" %}
module {{ wrapper_module_name }} #(
    parameter integer ADDR_WIDTH = {{ addr_width }},
    parameter integer DATA_WIDTH = {{ data_width }}
) (
    input  logic                  clk,
    input  logic                  rst_n,

    input  logic                  test_mode,
    input  logic                  bist_start,
    output logic                  bist_done,
    output logic                  bist_fail,

    input  logic                  func_csb,
    input  logic [ADDR_WIDTH-1:0] func_addr,
    input  logic [DATA_WIDTH-1:0] func_din,
    input  logic                  func_we,
    output logic [DATA_WIDTH-1:0] func_dout
{% if repair_ports %}
{% for rp in repair_ports %}
  , {{ rp.dir }} logic [{{ rp.width }}-1:0] {{ rp.name }}
{% endfor %}
{% endif %}
{% if has_onchip_selfrepair %}
  , input  logic self_repair_start
  , output logic self_repair_done
  , output logic self_repair_fail
  , output logic self_repair_busy
{% endif %}
{% if has_onchip_repair_persistence %}
  , input  logic repair_load
  , input  logic [{{ redundancy.num_spare_rows }}-1:0] fuse_row_repair_en
  , input  logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] fuse_faulty_row_addr
  , output logic repair_load_done
{% endif %}
);

{% if normalized_ports|length == 1 %}
    logic                  mbist_busy;
    logic                  mbist_sram_clk;
    logic                  mbist_sram_csb;
    logic                  mbist_sram_web;
    logic [ADDR_WIDTH-1:0] mbist_sram_addr;
    logic [DATA_WIDTH-1:0] mbist_sram_din;

    logic [ADDR_WIDTH-1:0] sram_addr;
    logic [DATA_WIDTH-1:0] sram_din;
    logic [DATA_WIDTH-1:0] sram_dout;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_word;
    logic [DATA_WIDTH-1:0] sram_dbg_fault_word;
    logic [DATA_WIDTH-1:0] sram_dbg_intended_word;
    logic [DATA_WIDTH-1:0] sram_dbg_prior_value;
    logic [DATA_WIDTH-1:0] sram_dbg_attempted_write;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_read;
    logic [DATA_WIDTH-1:0] sram_dbg_blocked_bits;
    logic                  sram_csb;
    logic                  sram_we;

    logic selected_write_req;
    logic mbist_write_req;

{% if has_onchip_selfrepair %}
    // Declared here (not alongside their instantiations below) because Icarus
    // requires a wire's declaration to textually precede its use, and these
    // are read by u_algo_top's instantiation and the test_mode mux immediately
    // below -- both ahead of where the modules that drive them are instantiated.
    logic                  algo_fail_valid;
    logic [ADDR_WIDTH-1:0] algo_fail_addr;
    logic                  effective_test_mode;
    logic                  effective_bist_start;
    logic                  ctrl_test_mode_override;
    logic                  ctrl_bist_start;
    logic                  registrar_enable;
    logic                  latch_result;
    logic                  unrepairable;
    logic [{{ redundancy.num_spare_rows }}-1:0]            row_repair_en;
    logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] faulty_row_addr;

    assign effective_test_mode  = test_mode || ctrl_test_mode_override;
    assign effective_bist_start = (bist_start && test_mode && !self_repair_busy) || ctrl_bist_start;
{% endif %}

    {{ algo_top_module }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .READ_LATENCY({{ read_latency }})
    ) u_algo_top (
        .clk(clk),
        .rst_n(rst_n),
        .bist_start({{ start_signal }}),
        .bist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
{% if has_onchip_selfrepair %}
        .bist_fail_valid(algo_fail_valid),
        .bist_fail_addr(algo_fail_addr),
{% endif %}
        .sram_clk0(mbist_sram_clk),
        .sram_csb0(mbist_sram_csb),
        .sram_web0(mbist_sram_web),
        .sram_addr0(mbist_sram_addr),
        .sram_din0(mbist_sram_din),
        .sram_dout0(sram_dout)
    );

    assign mbist_write_req    = ~mbist_sram_web;
    assign selected_write_req = {{ mode_signal }} ? mbist_write_req : func_we;

{% if we_active_low %}
    assign sram_we = ~selected_write_req;
{% else %}
    assign sram_we = selected_write_req;
{% endif %}

    assign sram_addr = {{ mode_signal }} ? mbist_sram_addr : func_addr;
    assign sram_din  = {{ mode_signal }} ? mbist_sram_din : func_din;
    assign sram_csb  = {{ mode_signal }} ? mbist_sram_csb : func_csb;
    assign func_dout = sram_dout;

{% if use_saboteur %}
    {% for pname, pdata in normalized_ports.items() %}
    {{ memory_name }}_saboteur #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout),
        .dbg_actual_word(sram_dbg_actual_word),
        .dbg_fault_word(sram_dbg_fault_word),
        .dbg_intended_word(sram_dbg_intended_word),
        .dbg_prior_value(sram_dbg_prior_value),
        .dbg_attempted_write(sram_dbg_attempted_write),
        .dbg_actual_read(sram_dbg_actual_read),
        .dbg_blocked_bits(sram_dbg_blocked_bits)
    );
    {% endfor %}
{% else %}
    {% for pname, pdata in normalized_ports.items() %}
{% if has_redundancy %}
{% if has_onchip_selfrepair %}
    // Row redundancy (on-chip self-repair): an EXTERNAL repair remap sits between
    // the address mux and a stock spare-augmented memory. An on-chip analyzer +
    // sequencer compute and apply the repair signature autonomously -- no
    // repair_ports/tester involvement (mutually exclusive by config validation).
    // (algo_fail_valid/algo_fail_addr/effective_test_mode/effective_bist_start/
    // row_repair_en/faulty_row_addr etc. are declared earlier, alongside
    // mbist_busy -- Icarus needs the declaration to precede u_algo_top's
    // instantiation and the test_mode mux, both of which come before this.)
    logic [{{ redundancy.mem_addr_width }}-1:0] sram_addr_phys;

    onchip_row_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .unrepairable(unrepairable)
    );

    onchip_selfrepair_ctrl u_onchip_selfrepair_ctrl (
        .clk(clk),
        .rst_n(rst_n),
        .self_repair_start(self_repair_start),
        .self_repair_done(self_repair_done),
        .self_repair_fail(self_repair_fail),
        .self_repair_busy(self_repair_busy),
        .ctrl_test_mode_override(ctrl_test_mode_override),
        .ctrl_bist_start(ctrl_bist_start),
        .mbist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
        .registrar_enable(registrar_enable),
        .latch_result(latch_result),
        .unrepairable(unrepairable)
    );

    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap (
        .addr_in(sram_addr),
        .addr_out(sram_addr_phys)
      , .row_repair_en(row_repair_en)
      , .faulty_row_addr(faulty_row_addr)
    );
{% else %}
    // Row redundancy: an EXTERNAL repair remap sits between the address mux and a
    // stock spare-augmented memory. The repair_ports pins drive the remap (not the
    // memory, which has no repair pins); the memory just sees the remapped address.
    logic [{{ redundancy.mem_addr_width }}-1:0] sram_addr_phys;

    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap (
        .addr_in(sram_addr),
        .addr_out(sram_addr_phys)
{% for rp in repair_ports %}
      , .{{ rp.name }}({{ rp.name }})
{% endfor %}
    );
{% endif %}

    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_sram (
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr_phys),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout)
    );
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout)
    );
{% endif %}
    {% endfor %}
{% endif %}
{% else %}
    logic mbist_busy;

{% if has_onchip_selfrepair %}
    // On-chip self-repair (march-1r1w): declared here (not alongside their
    // instantiations below) because Icarus requires a wire's declaration to
    // textually precede its use, and these are read by u_algo_top's
    // instantiation and the {{ mode_signal }} muxes immediately below -- both
    // ahead of where the modules that drive them are instantiated.
    logic                  algo_fail_valid;
    logic [ADDR_WIDTH-1:0] algo_fail_addr;
    logic                  effective_test_mode;
    logic                  effective_bist_start;
    logic                  ctrl_test_mode_override;
    logic                  ctrl_bist_start;
    logic                  registrar_enable;
    logic                  latch_result;
    logic                  unrepairable;
    logic [{{ redundancy.num_spare_rows }}-1:0]            row_repair_en;
    logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] faulty_row_addr;
    logic [{{ redundancy.mem_addr_width }}-1:0]            sram_addr_phys;

    assign effective_test_mode  = test_mode || ctrl_test_mode_override;
    assign effective_bist_start = (bist_start && test_mode && !self_repair_busy) || ctrl_bist_start;

{% endif %}
    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    logic                  mbist_sram_clk{{ suffix }};
    logic                  mbist_sram_csb{{ suffix }};
    {% if pdata.type in ("w", "rw") %}
    logic                  mbist_sram_web{{ suffix }};
    {% endif %}
    logic [ADDR_WIDTH-1:0] mbist_sram_addr{{ suffix }};
    {% if pdata.type in ("w", "rw") %}
    logic [DATA_WIDTH-1:0] mbist_sram_din{{ suffix }};
    {% endif %}
    {% if pdata.type in ("r", "rw") %}
    logic [DATA_WIDTH-1:0] sram_dout{{ suffix }};
    {% endif %}
    logic [ADDR_WIDTH-1:0] sram_addr{{ suffix }};
    {% if pdata.type in ("w", "rw") %}
    logic [DATA_WIDTH-1:0] sram_din{{ suffix }};
    logic                  sram_we{{ suffix }};
    logic                  selected_write_req{{ suffix }};
    logic                  mbist_write_req{{ suffix }};
    {% endif %}
    logic                  sram_csb{{ suffix }};
    {% endfor %}

    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    {% if pdata.type == "r" or (pdata.type == "rw" and suffix == "0") %}
    logic [DATA_WIDTH-1:0] sram_dbg_actual_word;
    logic [DATA_WIDTH-1:0] sram_dbg_fault_word;
    logic [DATA_WIDTH-1:0] sram_dbg_intended_word;
    logic [DATA_WIDTH-1:0] sram_dbg_prior_value;
    logic [DATA_WIDTH-1:0] sram_dbg_attempted_write;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_read;
    logic [DATA_WIDTH-1:0] sram_dbg_blocked_bits;
    {% endif %}
    {% endfor %}

    {{ algo_top_module }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .READ_LATENCY({{ read_latency }})
    ) u_algo_top (
        .clk(clk),
        .rst_n(rst_n),
        .bist_start({{ start_signal }}),
        .bist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
{% if has_onchip_selfrepair %}
        .bist_fail_valid(algo_fail_valid),
        .bist_fail_addr(algo_fail_addr),
{% endif %}
        {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% if pdata.type == "r" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_dout{{ suffix }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "w" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_web{{ suffix }}(mbist_sram_web{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_din{{ suffix }}(mbist_sram_din{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "rw" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_web{{ suffix }}(mbist_sram_web{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_din{{ suffix }}(mbist_sram_din{{ suffix }}),
        .sram_dout{{ suffix }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% endif %}
        {% endfor %}
    );

    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    {% if pdata.type == "w" %}
    assign mbist_write_req{{ suffix }}    = ~mbist_sram_web{{ suffix }};
    assign selected_write_req{{ suffix }} = {{ mode_signal }} ? mbist_write_req{{ suffix }} : func_we;

    {% if we_active_low %}
    assign sram_we{{ suffix }} = ~selected_write_req{{ suffix }};
    {% else %}
    assign sram_we{{ suffix }} = selected_write_req{{ suffix }};
    {% endif %}

    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_din{{ suffix }}  = {{ mode_signal }} ? mbist_sram_din{{ suffix }} : func_din;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    {% elif pdata.type == "rw" %}
    assign mbist_write_req{{ suffix }}    = ~mbist_sram_web{{ suffix }};
    assign selected_write_req{{ suffix }} = {{ mode_signal }} ? mbist_write_req{{ suffix }} : func_we;

    {% if we_active_low %}
    assign sram_we{{ suffix }} = ~selected_write_req{{ suffix }};
    {% else %}
    assign sram_we{{ suffix }} = selected_write_req{{ suffix }};
    {% endif %}

    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_din{{ suffix }}  = {{ mode_signal }} ? mbist_sram_din{{ suffix }} : func_din;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    {% if suffix == "0" %}
    // march-2rw's functional boundary is inherently single-port: only the
    // port assigned suffix "0" drives func_dout in functional (test_mode=0)
    // mode. The second port exists for the MBIST algorithm's internal
    // concurrency (e.g. concurrent read+write to different/same addresses),
    // not for external dual-port functional access.
    assign func_dout = sram_dout{{ suffix }};
    {% endif %}
    {% else %}
    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    assign func_dout = sram_dout{{ suffix }};
    {% endif %}
    {% endfor %}

{% if has_onchip_selfrepair %}
    // On-chip self-repair (march-1r1w): a SINGLE external repair remap steers
    // BOTH ports, because both always carry the identical logical address --
    // the FSM's shared addr_q in test mode, func_addr in functional mode (see
    // march_1r1w_fsm.sv). Port 0 (suffix "0", the read port under
    // _algo_port_suffixes) supplies the logical address to remap; the
    // resulting physical address feeds BOTH ports' memory instance below.
    onchip_row_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .unrepairable(unrepairable)
    );

    onchip_selfrepair_ctrl u_onchip_selfrepair_ctrl (
        .clk(clk),
        .rst_n(rst_n),
        .self_repair_start(self_repair_start),
        .self_repair_done(self_repair_done),
        .self_repair_fail(self_repair_fail),
        .self_repair_busy(self_repair_busy),
        .ctrl_test_mode_override(ctrl_test_mode_override),
        .ctrl_bist_start(ctrl_bist_start),
        .mbist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
        .registrar_enable(registrar_enable),
        .latch_result(latch_result),
        .unrepairable(unrepairable)
    );

    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap (
        .addr_in(sram_addr0)
      , .addr_out(sram_addr_phys)
      , .row_repair_en(row_repair_en)
      , .faulty_row_addr(faulty_row_addr)
    );

{% endif %}
{% if use_saboteur %}
    {{ memory_name }}_saboteur #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
    {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% if pdata.type == "r" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}),
        {% elif pdata.type == "w" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.din }}(sram_din{{ suffix }}),
        {% elif pdata.type == "rw" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.din }}(sram_din{{ suffix }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}),
        {% endif %}
    {% endfor %}
        .dbg_actual_word(sram_dbg_actual_word),
        .dbg_fault_word(sram_dbg_fault_word),
        .dbg_intended_word(sram_dbg_intended_word),
        .dbg_prior_value(sram_dbg_prior_value),
        .dbg_attempted_write(sram_dbg_attempted_write),
        .dbg_actual_read(sram_dbg_actual_read),
        .dbg_blocked_bits(sram_dbg_blocked_bits)
    );
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
{% if has_onchip_selfrepair %}
      , .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
{% endif %}
    ) u_sram (
    {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% set port_addr = "sram_addr_phys" if has_onchip_selfrepair else "sram_addr" ~ suffix %}
        {% if pdata.type == "r" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "w" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        .{{ pdata.din }}(sram_din{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "rw" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        .{{ pdata.din }}(sram_din{{ suffix }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% endif %}
    {% endfor %}
    );
{% endif %}
{% endif %}

endmodule
