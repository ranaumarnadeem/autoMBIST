`timescale 1ns/1ps
// Self-checking JTAG MBIST testbench for {{ top }}, wrapped for JTAG/IJTAG
// access by wrap-test-access -- generated by autombist.
//
// Plays {{ vectors_file }}, the TCK-level retargeting of run_mbist in
// {{ pdl_file }}: load EXTEST, write test_mode=1 and bist_start=1 through the
// IJTAG network, run clk for the BIST, read bist_done and bist_fail back, and
// return the controller to idle. The result is checked only at TDO, as a
// tester would; the wrapper's own pins are not looked at, and its control
// pins (JTAG-only once wrapped) are tied off. Prints one "MBIST RESULT:" line
// and ends with $fatal -- a non-zero exit from the simulator -- on a failure.
//
// Each vector line is "0 tms tdi tdo read" -- one TCK cycle; tdo is checked
// when read is nonzero (the read it belongs to, below) -- or "1 n 0 0 0":
// n clk cycles with TCK stopped in Run-Test/Idle.
`ifndef MBIST_VECTORS
`define MBIST_VECTORS "{{ vectors_file }}"
`endif

module tb_{{ top }}_jtag;
    localparam integer TCK_HALF = 25;  // ns; clk runs at 10 ns

    logic clk    = 1'b0;
    logic rst_n  = 1'b0;
    logic tck    = 1'b0;
    logic tms    = 1'b1;
    logic tdi    = 1'b0;
    logic trst_n = 1'b0;
    wire  tdo;
{% for p in idle_inputs %}
    logic {{ p.range }}{{ p.name }} = {{ p.idle }};
{% endfor %}
{% for p in outputs %}
    wire  {{ p.range }}{{ p.name }};
{% endfor %}

    {{ top }} dut (
{% for p in ports %}
        .{{ p.name }}({{ p.name }}){{ "," if not loop.last }}
{% endfor %}
    );

    always #5 clk = ~clk;

    // One TCK cycle: TMS/TDI set while TCK is low, TDO sampled just before the
    // rising edge that shifts.
    task automatic tck_cycle(input logic t, input logic d, output logic sampled);
        tms = t;
        tdi = d;
        #(TCK_HALF - 1) sampled = tdo;
        #1 tck = 1'b1;
        #TCK_HALF tck = 1'b0;
    endtask

    function automatic string read_label(input integer read);
        case (read)
{% for label in read_labels %}
            {{ loop.index }}: read_label = "{{ label }}";
{% endfor %}
            default: read_label = "?";
        endcase
    endfunction

    integer fd, code, kind, a, b, c, read, vectors, mismatches, failed_read;
    logic sampled;
    initial begin
        fd = $fopen(`MBIST_VECTORS, "r");
        if (fd == 0)
            $fatal(1, "MBIST RESULT: ERROR -- cannot open %s", `MBIST_VECTORS);
        // TAP and MBIST reset, then Test-Logic-Reset -> Run-Test/Idle.
        repeat (2) tck_cycle(1'b1, 1'b0, sampled);
        trst_n = 1'b1;
        rst_n  = 1'b1;
        tck_cycle(1'b0, 1'b0, sampled);

        vectors = 0;
        mismatches = 0;
        failed_read = 0;
        while (!$feof(fd)) begin
            code = $fscanf(fd, "%d %d %d %d %d\n", kind, a, b, c, read);
            if (code == 5) begin
                vectors = vectors + 1;
                if (kind == 1) begin
                    tms = 1'b0;
                    repeat (a) @(posedge clk);
                end else begin
                    tck_cycle(a[0], b[0], sampled);
                    if (read != 0 && sampled !== c[0]) begin
                        mismatches = mismatches + 1;
                        if (failed_read == 0) failed_read = read;
                    end
                end
            end
        end
        $fclose(fd);
        if (vectors == 0)
            $fatal(1, "MBIST RESULT: ERROR -- no vectors in %s", `MBIST_VECTORS);
        if (mismatches != 0)
            $fatal(1, "MBIST RESULT: FAIL -- TDO did not read back %s (%0d bit(s) differ)",
                   read_label(failed_read), mismatches);
        $display("MBIST RESULT: PASS -- read back through TDO:{% for label in read_labels %} {{ label }}{{ "," if not loop.last }}{% endfor %} (%0d vectors)", vectors);
        $finish;
    end
endmodule
