    end

    always_comb begin
        prior_word = shadow_mem[{{ _rw.addr }}];
        blocked_down = prior_word & (~{{ _rw.din }}) & tf_down_mask[{{ _rw.addr }}];
        real_din = ({{ _rw.din }} & ~blocked_down) | (prior_word & blocked_down);
    end

    always_ff @(posedge {{ _rw.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        if (write_cycle) begin
            shadow_mem[{{ _rw.addr }}] <= real_din;
            blocked_bits_q[{{ _rw.addr }}] <= blocked_down;
            if (blocked_down != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _rw.addr }};
                    pend_bits[free_slot] <= blocked_down;
                    pend_tgt[free_slot]  <= {{ _rw.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end

        if (read_cycle) begin
            read_data_q <= shadow_mem[{{ _rw.addr }}];
        end
    end
{% endif %}

{% if fault_type == "stuck-at" %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ _rw.clk }}({{ _rw.clk }}),
        .{{ _rw.csb }}({{ _rw.csb }}),
        .{{ _rw.we }}({{ _rw.we }}),
        .{{ _rw.addr }}({{ _rw.addr }}),
        .{{ _rw.din }}(real_din),
        .{{ _rw.dout }}(real_dout)
    );
{% endif %}

{% if fault_type == "stuck-at" %}
    assign real_din = {{ _rw.din }};
    assign {{ _rw.dout }} = (real_dout & sa0_mask[{{ _rw.addr }}]) | sa1_mask[{{ _rw.addr }}];
    assign dbg_actual_word = real_dout;
    assign dbg_fault_word = {{ _rw.dout }};
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = '0;
    assign dbg_attempted_write = '0;
    assign dbg_actual_read = real_dout;
    assign dbg_blocked_bits = '0;
{% elif fault_type == "transition-up" %}
    assign {{ _rw.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _rw.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_up : blocked_bits_q[{{ _rw.addr }}];
{% else %}
    assign {{ _rw.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _rw.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_down : blocked_bits_q[{{ _rw.addr }}];
{% endif %}

endmodule
{% else %}
{% set _rport = (normalized_ports.values() | selectattr("type", "equalto", "r") | list)[0] %}
{% set _wport = (normalized_ports.values() | selectattr("type", "equalto", "w") | list)[0] %}
// 1-read-port + 1-write-port saboteur: models stuck-at / transition faults over
// a SINGLE shared array indexed by both ports, mirroring sram_model_1r1w.sv's
// shared mem[] architecture with a fault-mask layer on top. write_cycle is
// derived from the write port ({{ _wport.csb }}/{{ _wport.we }}/{{ _wport.addr }}/{{ _wport.din }});
// read_cycle from the read port ({{ _rport.csb }}/{{ _rport.addr }}). Debug taps
// sample the read path (port 0), matching test_mbist.py's dbg_* sampling.
