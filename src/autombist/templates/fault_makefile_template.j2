# Auto-generated by autombist (test mode)
# Run from this directory: make
#
# Runs this fault-injection build through `autombist simulate`, so it works in
# any project, not only inside an autoMBIST checkout, and simulates the
# generated config (read latency included). MODEL=path/to/model.v simulates
# your own memory model in place of the generated behavioral one.

MODULE_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

MEMORY_NAME := {{ memory_name }}
WRAPPER_MODULE := {{ wrapper_module_name }}

USE_SABOTEUR := 1
FAULT_MODE := faults
FAULTS := {{ fault_count }}
FAULT_TYPE := {{ fault_type }}
PULSE_WIDTH_NS := {{ pulse_width_ns }}
ADDR_WIDTH := {{ addr_width }}
DATA_WIDTH := {{ data_width }}
{% if fault_seed is not none %}FAULT_SEED := {{ fault_seed }}
{% else %}FAULT_SEED :=
{% endif %}
ALGO := {{ algo }}

AUTOMBIST ?= autombist
MODEL ?=
SIMULATE = $(AUTOMBIST) simulate --out $(MODULE_DIR) $(if $(MODEL),--model $(MODEL))

.PHONY: all fault-test debug

all: fault-test

fault-test:
	@$(SIMULATE)

debug:
	@$(SIMULATE) --verbose
