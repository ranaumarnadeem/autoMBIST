`timescale 1ns/1ps

{% if normalized_ports|length == 1 %}
{% set _rw = (normalized_ports.values() | list)[0] %}
module {{ memory_name }}_saboteur #(
    parameter integer ADDR_WIDTH = {{ addr_width }},
    parameter integer DATA_WIDTH = {{ data_width }}
) (
    input  logic                  {{ _rw.clk }},
    input  logic                  {{ _rw.csb }},
    input  logic                  {{ _rw.we }},
    input  logic [ADDR_WIDTH-1:0] {{ _rw.addr }},
    input  logic [DATA_WIDTH-1:0] {{ _rw.din }},
    output logic [DATA_WIDTH-1:0] {{ _rw.dout }},
    output logic [DATA_WIDTH-1:0] dbg_actual_word,
    output logic [DATA_WIDTH-1:0] dbg_fault_word,
    output logic [DATA_WIDTH-1:0] dbg_intended_word,
    output logic [DATA_WIDTH-1:0] dbg_prior_value,
    output logic [DATA_WIDTH-1:0] dbg_attempted_write,
    output logic [DATA_WIDTH-1:0] dbg_actual_read,
    output logic [DATA_WIDTH-1:0] dbg_blocked_bits
);

    logic [DATA_WIDTH-1:0] real_dout;
    logic [DATA_WIDTH-1:0] real_din;
    logic write_cycle;
    logic read_cycle;

    assign write_cycle = (~{{ _rw.csb }}) & (~{{ _rw.we }});
    assign read_cycle  = (~{{ _rw.csb }}) & ({{ _rw.we }});

{% if fault_type == "stuck-at" %}
    logic [DATA_WIDTH-1:0] sa0_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] sa1_mask [0:(1<<ADDR_WIDTH)-1];

    initial begin
        $readmemh("{{ sa0_faults_file }}", sa0_mask);
        $readmemh("{{ sa1_faults_file }}", sa1_mask);
    end
{% elif fault_type == "transition-up" %}
    logic [DATA_WIDTH-1:0] tf_up_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] shadow_mem [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] blocked_bits_q [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] read_data_q;
    logic [DATA_WIDTH-1:0] prior_word;
    logic [DATA_WIDTH-1:0] blocked_up;
    localparam integer DELAY_CYCLES = ({{ pulse_width_ns }} < 1) ? 1 : {{ pulse_width_ns }};
    localparam integer DELAY_CNT_W = (DELAY_CYCLES < 2) ? 1 : $clog2(DELAY_CYCLES + 1);
    // Active-pending list (sim only): commit delayed transitions without scanning
    // the whole address space every clock. At most one write per cycle, each
    // pending for DELAY_CYCLES cycles, so MAX_PEND = DELAY_CYCLES + 2 always has a
    // free slot. Cost is O(DELAY_CYCLES)/clock, independent of memory depth.
    localparam integer MAX_PEND = DELAY_CYCLES + 2;
    logic [ADDR_WIDTH-1:0]  pend_addr [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_bits [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
    integer free_slot;

    initial begin
        $readmemh("{{ tf_up_faults_file }}", tf_up_mask);
        for (idx = 0; idx < (1<<ADDR_WIDTH); idx = idx + 1) begin
            shadow_mem[idx] = '0;
            blocked_bits_q[idx] = '0;
        end
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            pend_val[p] = 1'b0;
            pend_cnt[p] = '0;
        end
        read_data_q = '0;
    end

    always_comb begin
        prior_word = shadow_mem[{{ _rw.addr }}];
        blocked_up = (~prior_word) & {{ _rw.din }} & tf_up_mask[{{ _rw.addr }}];
        real_din = ({{ _rw.din }} & ~blocked_up) | (prior_word & blocked_up);
    end

    always_ff @(posedge {{ _rw.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        if (write_cycle) begin
            shadow_mem[{{ _rw.addr }}] <= real_din;
            blocked_bits_q[{{ _rw.addr }}] <= blocked_up;
            if (blocked_up != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _rw.addr }};
                    pend_bits[free_slot] <= blocked_up;
                    pend_tgt[free_slot]  <= {{ _rw.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end

        if (read_cycle) begin
            read_data_q <= shadow_mem[{{ _rw.addr }}];
        end
    end
{% elif fault_type == "transition-down" %}
    logic [DATA_WIDTH-1:0] tf_down_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] shadow_mem [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] blocked_bits_q [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] read_data_q;
    logic [DATA_WIDTH-1:0] prior_word;
    logic [DATA_WIDTH-1:0] blocked_down;
    localparam integer DELAY_CYCLES = ({{ pulse_width_ns }} < 1) ? 1 : {{ pulse_width_ns }};
    localparam integer DELAY_CNT_W = (DELAY_CYCLES < 2) ? 1 : $clog2(DELAY_CYCLES + 1);
    // Active-pending list (sim only): commit delayed transitions without scanning
    // the whole address space every clock. At most one write per cycle, each
    // pending for DELAY_CYCLES cycles, so MAX_PEND = DELAY_CYCLES + 2 always has a
    // free slot. Cost is O(DELAY_CYCLES)/clock, independent of memory depth.
    localparam integer MAX_PEND = DELAY_CYCLES + 2;
    logic [ADDR_WIDTH-1:0]  pend_addr [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_bits [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
    integer free_slot;

    initial begin
        $readmemh("{{ tf_down_faults_file }}", tf_down_mask);
        for (idx = 0; idx < (1<<ADDR_WIDTH); idx = idx + 1) begin
            shadow_mem[idx] = '0;
            blocked_bits_q[idx] = '0;
        end
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            pend_val[p] = 1'b0;
            pend_cnt[p] = '0;
        end
        read_data_q = '0;
    end

    always_comb begin
        prior_word = shadow_mem[{{ _rw.addr }}];
        blocked_down = prior_word & (~{{ _rw.din }}) & tf_down_mask[{{ _rw.addr }}];
        real_din = ({{ _rw.din }} & ~blocked_down) | (prior_word & blocked_down);
    end

    always_ff @(posedge {{ _rw.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        if (write_cycle) begin
            shadow_mem[{{ _rw.addr }}] <= real_din;
            blocked_bits_q[{{ _rw.addr }}] <= blocked_down;
            if (blocked_down != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _rw.addr }};
                    pend_bits[free_slot] <= blocked_down;
                    pend_tgt[free_slot]  <= {{ _rw.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end

        if (read_cycle) begin
            read_data_q <= shadow_mem[{{ _rw.addr }}];
        end
    end
{% endif %}
{% if fault_type in ("transition-up", "transition-down") %}
{% set _tfmask = "tf_up_mask" if fault_type == "transition-up" else "tf_down_mask" %}
    // Phase 3 -- transition write-transparency invariant. The transition
    // saboteur is a shadow model rather than a wrapper around the real memory
    // macro (unlike stuck-at / port-coupling, which DO wrap and validate the
    // real macro): it needs the pre-write cell value to decide whether a
    // 0->1 / 1->0 transition is blocked, plus a delay queue to model the
    // transition time -- neither expressible by masking a black-box macro's
    // dout. The real macro is therefore validated by the stuck-at / port-
    // coupling paths, not this one.
    //
    // A cycle-accurate read cross-check against a parallel real-macro instance
    // was tried and is intentionally NOT shipped: the shadow and a real macro
    // have legitimately different write-to-read visibility timing, so comparing
    // their reads cycle-by-cycle yields spurious mismatches even when both
    // models are correct. What IS robust and worth guarding is transparency:
    // at any address carrying NO transition-fault mask bit, the value actually
    // committed (real_din) must equal the intended write (din). This holds by
    // construction today; the assertion locks it against a future change to the
    // masking logic that might corrupt fault-free data. NON-FATAL -- it drives
    // neither {{ _rw.dout }} nor bist_fail, so it can never change a pass/fail
    // result; it only prints GOLDEN_CHECK_ACTIVE / GOLDEN_MISMATCH.
    logic gchk_active;
    initial gchk_active = 1'b0;
    always_ff @(posedge {{ _rw.clk }}) begin
        if (write_cycle && {{ _tfmask }}[{{ _rw.addr }}] == '0) begin
            if (!gchk_active) begin
                gchk_active <= 1'b1;
                $display("GOLDEN_CHECK_ACTIVE transition write-transparency invariant running");
            end
            if (real_din !== {{ _rw.din }})
                $display("GOLDEN_MISMATCH addr=%0d intended=%h committed=%h",
                         {{ _rw.addr }}, {{ _rw.din }}, real_din);
        end
    end
{% endif %}

{% if fault_type == "stuck-at" %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ _rw.clk }}({{ _rw.clk }}),
        .{{ _rw.csb }}({{ _rw.csb }}),
        .{{ _rw.we }}({{ _rw.we }}),
        .{{ _rw.addr }}({{ _rw.addr }}),
        .{{ _rw.din }}(real_din),
        .{{ _rw.dout }}(real_dout)
    );
{% endif %}

{% if fault_type == "stuck-at" %}
    assign real_din = {{ _rw.din }};
    assign {{ _rw.dout }} = (real_dout & sa0_mask[{{ _rw.addr }}]) | sa1_mask[{{ _rw.addr }}];
    assign dbg_actual_word = real_dout;
    assign dbg_fault_word = {{ _rw.dout }};
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = '0;
    assign dbg_attempted_write = '0;
    assign dbg_actual_read = real_dout;
    assign dbg_blocked_bits = '0;
{% elif fault_type == "transition-up" %}
    assign {{ _rw.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _rw.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_up : blocked_bits_q[{{ _rw.addr }}];
{% else %}
    assign {{ _rw.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _rw.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _rw.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_down : blocked_bits_q[{{ _rw.addr }}];
{% endif %}

endmodule
{% elif algo == "march-2rw" %}
{% set _port_names = normalized_ports.keys() | list %}
{% set _p0 = normalized_ports[_port_names[0]] %}
{% set _p1 = normalized_ports[_port_names[1]] %}
// 2RW (2x full read/write port) saboteur: models stuck-at / transition
// faults over a SINGLE shared array indexed by BOTH ports, mirroring
// sram_model_2rw.sv's shared mem[] architecture with a fault-mask layer on
// top -- NOT two independent single-port saboteurs. Port order (and hence
// which named config port is "port 0" vs "port 1" below) is determined by
// ORDERED ITERATION of normalized_ports, matching _algo_port_suffixes'
// march-2rw rule in generator.py: the first port in the config's ``ports:``
// map is port 0, the second is port 1. Debug taps (dbg_actual_word etc.)
// are scoped to port 0 ONLY, matching the 1R1W branch's documented
// convention above.
//
// port-coupling is NOT supported for march-2rw (see
// _validate_port_coupling_topology in generator.py, which rejects any algo
// other than march-1r1w) -- only stuck-at and transition-up/down are
// generated here.
module {{ memory_name }}_saboteur #(
    parameter integer ADDR_WIDTH = {{ addr_width }},
    parameter integer DATA_WIDTH = {{ data_width }}
) (
    // Port 0: full read/write.
    input  logic                  {{ _p0.clk }},
    input  logic                  {{ _p0.csb }},
    input  logic                  {{ _p0.we }},
    input  logic [ADDR_WIDTH-1:0] {{ _p0.addr }},
    input  logic [DATA_WIDTH-1:0] {{ _p0.din }},
    output logic [DATA_WIDTH-1:0] {{ _p0.dout }},

    // Port 1: full read/write.
    input  logic                  {{ _p1.clk }},
    input  logic                  {{ _p1.csb }},
    input  logic                  {{ _p1.we }},
    input  logic [ADDR_WIDTH-1:0] {{ _p1.addr }},
    input  logic [DATA_WIDTH-1:0] {{ _p1.din }},
    output logic [DATA_WIDTH-1:0] {{ _p1.dout }},

    output logic [DATA_WIDTH-1:0] dbg_actual_word,
    output logic [DATA_WIDTH-1:0] dbg_fault_word,
    output logic [DATA_WIDTH-1:0] dbg_intended_word,
    output logic [DATA_WIDTH-1:0] dbg_prior_value,
    output logic [DATA_WIDTH-1:0] dbg_attempted_write,
    output logic [DATA_WIDTH-1:0] dbg_actual_read,
    output logic [DATA_WIDTH-1:0] dbg_blocked_bits
);

    logic [DATA_WIDTH-1:0] real_dout0;
    logic [DATA_WIDTH-1:0] real_dout1;
    logic [DATA_WIDTH-1:0] real_din0;
    logic [DATA_WIDTH-1:0] real_din1;
    logic write_cycle0;
    logic write_cycle1;
    logic read_cycle0;
    logic read_cycle1;

    assign write_cycle0 = (~{{ _p0.csb }}) & (~{{ _p0.we }});
    assign write_cycle1 = (~{{ _p1.csb }}) & (~{{ _p1.we }});
    assign read_cycle0  = (~{{ _p0.csb }}) & ({{ _p0.we }});
    assign read_cycle1  = (~{{ _p1.csb }}) & ({{ _p1.we }});

{% if fault_type == "stuck-at" %}
    // Shared across both ports: each port's dout is independently masked by
    // its OWN address, matching sram_model_2rw.sv's single shared mem[].
    logic [DATA_WIDTH-1:0] sa0_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] sa1_mask [0:(1<<ADDR_WIDTH)-1];

    initial begin
        $readmemh("{{ sa0_faults_file }}", sa0_mask);
        $readmemh("{{ sa1_faults_file }}", sa1_mask);
    end

    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ _p0.clk }}({{ _p0.clk }}),
        .{{ _p0.csb }}({{ _p0.csb }}),
        .{{ _p0.we }}({{ _p0.we }}),
        .{{ _p0.addr }}({{ _p0.addr }}),
        .{{ _p0.din }}(real_din0),
        .{{ _p0.dout }}(real_dout0),
        .{{ _p1.clk }}({{ _p1.clk }}),
        .{{ _p1.csb }}({{ _p1.csb }}),
        .{{ _p1.we }}({{ _p1.we }}),
        .{{ _p1.addr }}({{ _p1.addr }}),
        .{{ _p1.din }}(real_din1),
        .{{ _p1.dout }}(real_dout1)
    );

    assign real_din0 = {{ _p0.din }};
    assign real_din1 = {{ _p1.din }};
    assign {{ _p0.dout }} = (real_dout0 & sa0_mask[{{ _p0.addr }}]) | sa1_mask[{{ _p0.addr }}];
    assign {{ _p1.dout }} = (real_dout1 & sa0_mask[{{ _p1.addr }}]) | sa1_mask[{{ _p1.addr }}];
    assign dbg_actual_word = real_dout0;
    assign dbg_fault_word = {{ _p0.dout }};
    assign dbg_intended_word = {{ _p0.din }};
    assign dbg_prior_value = '0;
    assign dbg_attempted_write = '0;
    assign dbg_actual_read = real_dout0;
    assign dbg_blocked_bits = '0;
{% elif fault_type in ("transition-up", "transition-down") %}
    // Shared shadow array across both ports (mirrors sram_model_2rw.sv's
    // single mem[]). Each port's write path independently computes its own
    // prior_word/blocked_bits/real_din from its own addr/din. The pending-
    // write delay list is sized for TWO potentially-concurrent in-flight
    // writes (one per port) rather than one, since either port -- or both,
    // on different addresses the same cycle -- can be mid-delay at once.
    logic [DATA_WIDTH-1:0] tf_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] shadow_mem [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] blocked_bits_q [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] read_data_q0;
    logic [DATA_WIDTH-1:0] read_data_q1;
    logic [DATA_WIDTH-1:0] prior_word0;
    logic [DATA_WIDTH-1:0] prior_word1;
    logic [DATA_WIDTH-1:0] blocked0;
    logic [DATA_WIDTH-1:0] blocked1;
    localparam integer DELAY_CYCLES = ({{ pulse_width_ns }} < 1) ? 1 : {{ pulse_width_ns }};
    localparam integer DELAY_CNT_W = (DELAY_CYCLES < 2) ? 1 : $clog2(DELAY_CYCLES + 1);
    // Active-pending list (sim only): commit delayed transitions without
    // scanning the whole address space every clock. At most one write per
    // port per cycle (2 ports), each pending for DELAY_CYCLES cycles, so
    // MAX_PEND = 2*DELAY_CYCLES + 4 always has a free slot for both ports.
    // Cost is O(DELAY_CYCLES)/clock, independent of memory depth.
    localparam integer MAX_PEND = 2 * DELAY_CYCLES + 4;
    logic [ADDR_WIDTH-1:0]  pend_addr [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_bits [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
    integer free_slot;
    integer slot0_claimed;

    initial begin
        $readmemh("{{ tf_up_faults_file if fault_type == "transition-up" else tf_down_faults_file }}", tf_mask);
        for (idx = 0; idx < (1<<ADDR_WIDTH); idx = idx + 1) begin
            shadow_mem[idx] = '0;
            blocked_bits_q[idx] = '0;
        end
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            pend_val[p] = 1'b0;
            pend_cnt[p] = '0;
        end
        read_data_q0 = '0;
        read_data_q1 = '0;
    end

    always_comb begin
        prior_word0 = shadow_mem[{{ _p0.addr }}];
        prior_word1 = shadow_mem[{{ _p1.addr }}];
    {% if fault_type == "transition-up" %}
        blocked0 = (~prior_word0) & {{ _p0.din }} & tf_mask[{{ _p0.addr }}];
        blocked1 = (~prior_word1) & {{ _p1.din }} & tf_mask[{{ _p1.addr }}];
    {% else %}
        blocked0 = prior_word0 & (~{{ _p0.din }}) & tf_mask[{{ _p0.addr }}];
        blocked1 = prior_word1 & (~{{ _p1.din }}) & tf_mask[{{ _p1.addr }}];
    {% endif %}
        real_din0 = ({{ _p0.din }} & ~blocked0) | (prior_word0 & blocked0);
        real_din1 = ({{ _p1.din }} & ~blocked1) | (prior_word1 & blocked1);
    end

    always_ff @(posedge {{ _p0.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        // NOTE: both write_cycle0 and write_cycle1 can fire THIS SAME
        // always_ff invocation (clk0/clk1 tied together, both ports writing
        // different addresses the same cycle). Port 0's free-slot claim uses
        // a blocking assignment to a scratch reg (slot0_claimed) so port 1's
        // scan below can see it and avoid double-allocating the same slot --
        // the pend_val[] array itself is only ever updated non-blocking, so
        // without this the two scans (both reading pend_val[] as it stood at
        // the top of this edge) could otherwise pick the same free_slot.
        slot0_claimed = -1;
        if (write_cycle0) begin
            shadow_mem[{{ _p0.addr }}] <= real_din0;
            blocked_bits_q[{{ _p0.addr }}] <= blocked0;
            if (blocked0 != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    slot0_claimed = free_slot;
                    pend_addr[free_slot] <= {{ _p0.addr }};
                    pend_bits[free_slot] <= blocked0;
                    pend_tgt[free_slot]  <= {{ _p0.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end

        if (write_cycle1) begin
            shadow_mem[{{ _p1.addr }}] <= real_din1;
            blocked_bits_q[{{ _p1.addr }}] <= blocked1;
            if (blocked1 != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p] && p != slot0_claimed) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _p1.addr }};
                    pend_bits[free_slot] <= blocked1;
                    pend_tgt[free_slot]  <= {{ _p1.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end

        if (read_cycle0) begin
            read_data_q0 <= shadow_mem[{{ _p0.addr }}];
        end
    end

    always_ff @(posedge {{ _p1.clk }}) begin
        if (read_cycle1) begin
            read_data_q1 <= shadow_mem[{{ _p1.addr }}];
        end
    end

    // Phase 3 -- transition write-transparency invariant (2RW, per port). Same
    // rationale as the single-port branch: transition uses a shadow model (the
    // real macro is validated by the stuck-at / port-coupling paths), and a
    // cycle-accurate read cross-check vs a parallel real-macro instance is
    // precluded by the two models' different write-to-read timing. At any
    // address with no transition-fault mask bit, each port's committed value
    // (real_dinN) must equal its intended write. Non-fatal: prints
    // GOLDEN_CHECK_ACTIVE / GOLDEN_MISMATCH, never drives dout or bist_fail.
    logic gchk_active;
    initial gchk_active = 1'b0;
    always_ff @(posedge {{ _p0.clk }}) begin
        if (write_cycle0 && tf_mask[{{ _p0.addr }}] == '0) begin
            if (!gchk_active) begin
                gchk_active <= 1'b1;
                $display("GOLDEN_CHECK_ACTIVE transition write-transparency invariant running");
            end
            if (real_din0 !== {{ _p0.din }})
                $display("GOLDEN_MISMATCH port=0 addr=%0d intended=%h committed=%h",
                         {{ _p0.addr }}, {{ _p0.din }}, real_din0);
        end
        if (write_cycle1 && tf_mask[{{ _p1.addr }}] == '0) begin
            if (real_din1 !== {{ _p1.din }})
                $display("GOLDEN_MISMATCH port=1 addr=%0d intended=%h committed=%h",
                         {{ _p1.addr }}, {{ _p1.din }}, real_din1);
        end
    end

    assign {{ _p0.dout }} = read_data_q0;
    assign {{ _p1.dout }} = read_data_q1;
    assign dbg_actual_word = prior_word0;
    assign dbg_fault_word = real_din0;
    assign dbg_intended_word = {{ _p0.din }};
    assign dbg_prior_value = prior_word0;
    assign dbg_attempted_write = {{ _p0.din }};
    assign dbg_actual_read = read_data_q0;
    assign dbg_blocked_bits = write_cycle0 ? blocked0 : blocked_bits_q[{{ _p0.addr }}];
{% endif %}

endmodule
{% else %}
{% set _rport = (normalized_ports.values() | selectattr("type", "equalto", "r") | list)[0] %}
{% set _wport = (normalized_ports.values() | selectattr("type", "equalto", "w") | list)[0] %}
// 1-read-port + 1-write-port saboteur: models stuck-at / transition / port-
// coupling faults over a SINGLE shared array indexed by both ports, mirroring
// sram_model_1r1w.sv's shared mem[] architecture with a fault-mask layer on
// top. write_cycle is derived from the write port
// ({{ _wport.csb }}/{{ _wport.we }}/{{ _wport.addr }}/{{ _wport.din }});
// read_cycle from the read port ({{ _rport.csb }}/{{ _rport.addr }}). Debug taps
// sample the read path (port 0), matching test_mbist.py's dbg_* sampling.
//
// port-coupling models an inter-port bridging defect: an aggressor write on
// the write port disturbs a victim read on the read port ONLY when both
// touch the SAME address on the SAME clock edge (genuine concurrent access).
// The march_1r1w controller (march_1r1w_fsm.sv) asserts read_cycle for
// EXACTLY ONE CYCLE (the ST_ISSUE cycle), then waits READ_LATENCY more
// cycles (ST_WAIT/ST_CHECK) before actually comparing mem_rdata0 against the
// expected value -- so the corruption must still be visible on dout that
// many cycles later, not just on the issue cycle itself. The real memory
// macro's own registered dout holds a write's value stable from one cycle
// after the write until the address is written again; the coupling flag
// must have that SAME per-address, write-scoped lifetime (set on a write
// cycle that coincides with a same-address read issue, cleared on the next
// write to that address) so it stays valid for however long the controller
// takes to actually sample it, instead of only for one cycle.
module {{ memory_name }}_saboteur #(
    parameter integer ADDR_WIDTH = {{ addr_width }},
    parameter integer DATA_WIDTH = {{ data_width }}
) (
    // Read port (read-only).
    input  logic                  {{ _rport.clk }},
    input  logic                  {{ _rport.csb }},
    input  logic [ADDR_WIDTH-1:0] {{ _rport.addr }},
    output logic [DATA_WIDTH-1:0] {{ _rport.dout }},

    // Write port (write-only).
    input  logic                  {{ _wport.clk }},
    input  logic                  {{ _wport.csb }},
    input  logic                  {{ _wport.we }},
    input  logic [ADDR_WIDTH-1:0] {{ _wport.addr }},
    input  logic [DATA_WIDTH-1:0] {{ _wport.din }},

    output logic [DATA_WIDTH-1:0] dbg_actual_word,
    output logic [DATA_WIDTH-1:0] dbg_fault_word,
    output logic [DATA_WIDTH-1:0] dbg_intended_word,
    output logic [DATA_WIDTH-1:0] dbg_prior_value,
    output logic [DATA_WIDTH-1:0] dbg_attempted_write,
    output logic [DATA_WIDTH-1:0] dbg_actual_read,
    output logic [DATA_WIDTH-1:0] dbg_blocked_bits
);

    logic [DATA_WIDTH-1:0] real_dout;
    logic [DATA_WIDTH-1:0] real_din;
    logic write_cycle;
    logic read_cycle;

    assign write_cycle = (~{{ _wport.csb }}) & (~{{ _wport.we }});
    assign read_cycle  = (~{{ _rport.csb }});

{% if fault_type == "stuck-at" %}
    logic [DATA_WIDTH-1:0] sa0_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] sa1_mask [0:(1<<ADDR_WIDTH)-1];

    initial begin
        $readmemh("{{ sa0_faults_file }}", sa0_mask);
        $readmemh("{{ sa1_faults_file }}", sa1_mask);
    end
{% elif fault_type == "transition-up" %}
    logic [DATA_WIDTH-1:0] tf_up_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] shadow_mem [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] blocked_bits_q [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] read_data_q;
    logic [DATA_WIDTH-1:0] prior_word;
    logic [DATA_WIDTH-1:0] blocked_up;
    localparam integer DELAY_CYCLES = ({{ pulse_width_ns }} < 1) ? 1 : {{ pulse_width_ns }};
    localparam integer DELAY_CNT_W = (DELAY_CYCLES < 2) ? 1 : $clog2(DELAY_CYCLES + 1);
    // Active-pending list (sim only): commit delayed transitions without scanning
    // the whole address space every clock. At most one write per cycle, each
    // pending for DELAY_CYCLES cycles, so MAX_PEND = DELAY_CYCLES + 2 always has a
    // free slot. Cost is O(DELAY_CYCLES)/clock, independent of memory depth.
    localparam integer MAX_PEND = DELAY_CYCLES + 2;
    logic [ADDR_WIDTH-1:0]  pend_addr [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_bits [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
    integer free_slot;

    initial begin
        $readmemh("{{ tf_up_faults_file }}", tf_up_mask);
        for (idx = 0; idx < (1<<ADDR_WIDTH); idx = idx + 1) begin
            shadow_mem[idx] = '0;
            blocked_bits_q[idx] = '0;
        end
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            pend_val[p] = 1'b0;
            pend_cnt[p] = '0;
        end
        read_data_q = '0;
    end

    always_comb begin
        prior_word = shadow_mem[{{ _wport.addr }}];
        blocked_up = (~prior_word) & {{ _wport.din }} & tf_up_mask[{{ _wport.addr }}];
        real_din = ({{ _wport.din }} & ~blocked_up) | (prior_word & blocked_up);
    end

    always_ff @(posedge {{ _wport.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        if (write_cycle) begin
            shadow_mem[{{ _wport.addr }}] <= real_din;
            blocked_bits_q[{{ _wport.addr }}] <= blocked_up;
            if (blocked_up != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _wport.addr }};
                    pend_bits[free_slot] <= blocked_up;
                    pend_tgt[free_slot]  <= {{ _wport.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end
    end

    always_ff @(posedge {{ _rport.clk }}) begin
        if (read_cycle) begin
            read_data_q <= shadow_mem[{{ _rport.addr }}];
        end
    end
{% elif fault_type == "transition-down" %}
    logic [DATA_WIDTH-1:0] tf_down_mask [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] shadow_mem [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] blocked_bits_q [0:(1<<ADDR_WIDTH)-1];
    logic [DATA_WIDTH-1:0] read_data_q;
    logic [DATA_WIDTH-1:0] prior_word;
    logic [DATA_WIDTH-1:0] blocked_down;
    localparam integer DELAY_CYCLES = ({{ pulse_width_ns }} < 1) ? 1 : {{ pulse_width_ns }};
    localparam integer DELAY_CNT_W = (DELAY_CYCLES < 2) ? 1 : $clog2(DELAY_CYCLES + 1);
    // Active-pending list (sim only): commit delayed transitions without scanning
    // the whole address space every clock. At most one write per cycle, each
    // pending for DELAY_CYCLES cycles, so MAX_PEND = DELAY_CYCLES + 2 always has a
    // free slot. Cost is O(DELAY_CYCLES)/clock, independent of memory depth.
    localparam integer MAX_PEND = DELAY_CYCLES + 2;
    logic [ADDR_WIDTH-1:0]  pend_addr [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_bits [0:MAX_PEND-1];
    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
    integer free_slot;

    initial begin
        $readmemh("{{ tf_down_faults_file }}", tf_down_mask);
        for (idx = 0; idx < (1<<ADDR_WIDTH); idx = idx + 1) begin
            shadow_mem[idx] = '0;
            blocked_bits_q[idx] = '0;
        end
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            pend_val[p] = 1'b0;
            pend_cnt[p] = '0;
        end
        read_data_q = '0;
    end

    always_comb begin
        prior_word = shadow_mem[{{ _wport.addr }}];
        blocked_down = prior_word & (~{{ _wport.din }}) & tf_down_mask[{{ _wport.addr }}];
        real_din = ({{ _wport.din }} & ~blocked_down) | (prior_word & blocked_down);
    end

    always_ff @(posedge {{ _wport.clk }}) begin
        for (p = 0; p < MAX_PEND; p = p + 1) begin
            if (pend_val[p]) begin
                if (pend_cnt[p] <= 1) begin
                    shadow_mem[pend_addr[p]] <= (shadow_mem[pend_addr[p]] & ~pend_bits[p]) | (pend_tgt[p] & pend_bits[p]);
                    blocked_bits_q[pend_addr[p]] <= '0;
                    pend_val[p] <= 1'b0;
                end else begin
                    pend_cnt[p] <= pend_cnt[p] - 1'b1;
                end
            end
        end

        if (write_cycle) begin
            shadow_mem[{{ _wport.addr }}] <= real_din;
            blocked_bits_q[{{ _wport.addr }}] <= blocked_down;
            if (blocked_down != '0) begin
                free_slot = -1;
                for (p = MAX_PEND - 1; p >= 0; p = p - 1) begin
                    if (!pend_val[p]) free_slot = p;
                end
                if (free_slot >= 0) begin
                    pend_addr[free_slot] <= {{ _wport.addr }};
                    pend_bits[free_slot] <= blocked_down;
                    pend_tgt[free_slot]  <= {{ _wport.din }};
                    pend_cnt[free_slot]  <= DELAY_CYCLES;
                    pend_val[free_slot]  <= 1'b1;
                end
            end
        end
    end

    always_ff @(posedge {{ _rport.clk }}) begin
        if (read_cycle) begin
            read_data_q <= shadow_mem[{{ _rport.addr }}];
        end
    end
{% elif fault_type == "port-coupling" %}
    logic [DATA_WIDTH-1:0] pc_mask [0:(1<<ADDR_WIDTH)-1];
    // Per-address sticky coupling-corruption flags: set (to the fault
    // pattern) on a write cycle that coincides with a same-address read
    // issued the SAME cycle -- a genuine concurrent access -- and cleared on
    // the NEXT write to that same address (whether or not that later write
    // is itself coincident). This mirrors blocked_bits_q's per-address,
    // write-scoped lifetime in the transition-fault branches above: the
    // memory macro's own registered dout holds the corrupted value stable
    // from the write cycle onward (same 1-cycle registered-read timing as
    // stuck-at) until the address is written again, so the flag must persist
    // exactly as long as real_dout itself reflects that write -- not just for
    // one cycle -- to line up with whenever the MBIST controller actually
    // samples it (which may be more than one cycle after the write, e.g.
    // while READ_LATENCY elapses).
    logic [DATA_WIDTH-1:0] coupling_bits_q [0:(1<<ADDR_WIDTH)-1];
    integer pc_idx;

    initial begin
        $readmemh("{{ pc_faults_file }}", pc_mask);
        for (pc_idx = 0; pc_idx < (1<<ADDR_WIDTH); pc_idx = pc_idx + 1) begin
            coupling_bits_q[pc_idx] = '0;
        end
    end

    always_ff @(posedge {{ _wport.clk }}) begin
        if (write_cycle) begin
            coupling_bits_q[{{ _wport.addr }}] <=
                (read_cycle && ({{ _rport.addr }} == {{ _wport.addr }})) ? pc_mask[{{ _wport.addr }}] : '0;
        end
    end
{% endif %}
{% if fault_type in ("transition-up", "transition-down") %}
{% set _tfmask = "tf_up_mask" if fault_type == "transition-up" else "tf_down_mask" %}
    // Phase 3 -- transition write-transparency invariant (1R1W write port). Same
    // rationale as the single-port branch: transition uses a shadow model (the
    // real macro is validated by the stuck-at / port-coupling paths), and a
    // cycle-accurate read cross-check vs a parallel real-macro instance is
    // precluded by the two models' different write-to-read timing. At any
    // address with no transition-fault mask bit, the committed value (real_din)
    // must equal the intended write. Non-fatal: prints GOLDEN_CHECK_ACTIVE /
    // GOLDEN_MISMATCH, never drives {{ _rport.dout }} or bist_fail.
    logic gchk_active;
    initial gchk_active = 1'b0;
    always_ff @(posedge {{ _wport.clk }}) begin
        if (write_cycle && {{ _tfmask }}[{{ _wport.addr }}] == '0) begin
            if (!gchk_active) begin
                gchk_active <= 1'b1;
                $display("GOLDEN_CHECK_ACTIVE transition write-transparency invariant running");
            end
            if (real_din !== {{ _wport.din }})
                $display("GOLDEN_MISMATCH addr=%0d intended=%h committed=%h",
                         {{ _wport.addr }}, {{ _wport.din }}, real_din);
        end
    end
{% endif %}

{% if fault_type in ("stuck-at", "port-coupling") %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ _rport.clk }}({{ _rport.clk }}),
        .{{ _rport.csb }}({{ _rport.csb }}),
        .{{ _rport.addr }}({{ _rport.addr }}),
        .{{ _rport.dout }}(real_dout),
        .{{ _wport.clk }}({{ _wport.clk }}),
        .{{ _wport.csb }}({{ _wport.csb }}),
        .{{ _wport.we }}({{ _wport.we }}),
        .{{ _wport.addr }}({{ _wport.addr }}),
        .{{ _wport.din }}(real_din)
    );
{% endif %}

{% if fault_type == "stuck-at" %}
    assign real_din = {{ _wport.din }};
    assign {{ _rport.dout }} = (real_dout & sa0_mask[{{ _rport.addr }}]) | sa1_mask[{{ _rport.addr }}];
    assign dbg_actual_word = real_dout;
    assign dbg_fault_word = {{ _rport.dout }};
    assign dbg_intended_word = {{ _wport.din }};
    assign dbg_prior_value = '0;
    assign dbg_attempted_write = '0;
    assign dbg_actual_read = real_dout;
    assign dbg_blocked_bits = '0;
{% elif fault_type == "port-coupling" %}
    assign real_din = {{ _wport.din }};
    assign {{ _rport.dout }} = real_dout ^ coupling_bits_q[{{ _rport.addr }}];
    assign dbg_actual_word = real_dout;
    assign dbg_fault_word = {{ _rport.dout }};
    assign dbg_intended_word = {{ _wport.din }};
    assign dbg_prior_value = real_dout;
    assign dbg_attempted_write = {{ _wport.din }};
    assign dbg_actual_read = real_dout;
    assign dbg_blocked_bits = coupling_bits_q[{{ _rport.addr }}];
{% elif fault_type == "transition-up" %}
    assign {{ _rport.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _wport.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _wport.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_up : blocked_bits_q[{{ _rport.addr }}];
{% else %}
    assign {{ _rport.dout }} = read_data_q;
    assign dbg_actual_word = prior_word;
    assign dbg_fault_word = real_din;
    assign dbg_intended_word = {{ _wport.din }};
    assign dbg_prior_value = prior_word;
    assign dbg_attempted_write = {{ _wport.din }};
    assign dbg_actual_read = read_data_q;
    assign dbg_blocked_bits = write_cycle ? blocked_down : blocked_bits_q[{{ _rport.addr }}];
{% endif %}

endmodule
{% endif %}
