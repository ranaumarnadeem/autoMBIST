`timescale 1ns/1ps

{% set has_redundancy = redundancy is defined and redundancy.num_spare_rows > 0 %}
{% set has_col_repair = has_redundancy and redundancy.num_spare_cols > 0 %}
{% set has_onchip_selfrepair = has_redundancy and redundancy.onchip_selfrepair %}
{% set has_onchip_col_repair = has_onchip_selfrepair and redundancy.onchip_col_repair %}
{% set has_dual_rw_col_repair = has_onchip_col_repair and (normalized_ports.values() | map(attribute='type') | list | sort) == ['rw', 'rw'] %}
{% set has_onchip_repair_persistence = has_onchip_selfrepair and redundancy.onchip_repair_persistence %}
{% set has_onchip_diagnosis = has_onchip_selfrepair and redundancy.onchip_diagnosis %}
{% set mode_signal = "effective_test_mode" if has_onchip_selfrepair else "test_mode" %}
{% set start_signal = "effective_bist_start" if has_onchip_selfrepair else "bist_start && test_mode" %}
{# Shared-bus MBIST controller (docs/shared-hierarchical-mbist-plan.md §4a):
   one controller FSM (u_algo_top) sequenced across NUM_MEMORIES physical
   memories one at a time, mux-selected. `memories` is only ever defined by
   a topology: shared-bus config (step 2 of that plan) -- absent (every
   config today), num_memories is exactly 1 and is_shared_bus is false, so
   every existing render stays byte-identical. Scoped to the plain
   single-port, non-redundant, non-self-repair, non-saboteur path only for
   now; combining shared-bus with those is a config-validation concern
   (step 2), not handled here. #}
{% set num_memories = memories|length if memories is defined else 1 %}
{% set is_shared_bus = num_memories > 1 %}
{% set mem_sel_width = (num_memories - 1).bit_length() if is_shared_bus else 1 %}
module {{ wrapper_module_name }} #(
    parameter integer ADDR_WIDTH = {{ addr_width }},
    parameter integer DATA_WIDTH = {{ data_width }}
) (
    input  logic                  clk,
    input  logic                  rst_n,

    input  logic                  test_mode,
    input  logic                  bist_start,
    output logic                  bist_done,
    output logic                  bist_fail,

    input  logic                  func_csb,
    input  logic [ADDR_WIDTH-1:0] func_addr,
    input  logic [DATA_WIDTH-1:0] func_din,
    input  logic                  func_we,
    output logic [DATA_WIDTH-1:0] func_dout
{% if repair_ports %}
{% for rp in repair_ports %}
  , {{ rp.dir }} logic [{{ rp.width }}-1:0] {{ rp.name }}
{% endfor %}
{% endif %}
{% if has_onchip_selfrepair %}
  , input  logic self_repair_start
  , output logic self_repair_done
  , output logic self_repair_fail
  , output logic self_repair_busy
{% endif %}
{% if has_onchip_repair_persistence %}
  , input  logic repair_load
  , input  logic [{{ redundancy.num_spare_rows }}-1:0] fuse_row_repair_en
  , input  logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] fuse_faulty_row_addr
  , output logic repair_load_done
{% endif %}
{% if has_onchip_diagnosis %}
  , output logic [{{ redundancy.num_diagnosis_entries }}-1:0] diag_valid
  , output logic [{{ redundancy.num_diagnosis_entries }}*ADDR_WIDTH-1:0] diag_addr
  , output logic diag_overflow
{% endif %}
);

{% if normalized_ports|length == 1 %}
    logic                  mbist_busy;
    logic                  mbist_sram_clk;
    logic                  mbist_sram_csb;
    logic                  mbist_sram_web;
    logic [ADDR_WIDTH-1:0] mbist_sram_addr;
    logic [DATA_WIDTH-1:0] mbist_sram_din;

    logic [ADDR_WIDTH-1:0] sram_addr;
    logic [DATA_WIDTH-1:0] sram_din;
    logic [DATA_WIDTH-1:0] sram_dout;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_word;
    logic [DATA_WIDTH-1:0] sram_dbg_fault_word;
    logic [DATA_WIDTH-1:0] sram_dbg_intended_word;
    logic [DATA_WIDTH-1:0] sram_dbg_prior_value;
    logic [DATA_WIDTH-1:0] sram_dbg_attempted_write;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_read;
    logic [DATA_WIDTH-1:0] sram_dbg_blocked_bits;
    logic                  sram_csb;
    logic                  sram_we;

    logic selected_write_req;
    logic mbist_write_req;

{% if has_onchip_selfrepair and not is_shared_bus %}
    // Declared here (not alongside their instantiations below) because Icarus
    // requires a wire's declaration to textually precede its use, and these
    // are read by u_algo_top's instantiation and the test_mode mux immediately
    // below -- both ahead of where the modules that drive them are instantiated.
    logic                  algo_fail_valid;
    logic [ADDR_WIDTH-1:0] algo_fail_addr;
    logic                  effective_test_mode;
    logic                  effective_bist_start;
    logic                  ctrl_test_mode_override;
    logic                  ctrl_bist_start;
    logic                  registrar_enable;
    logic                  latch_result;
    logic                  unrepairable;
    logic [{{ redundancy.num_spare_rows }}-1:0]            row_repair_en;
    logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] faulty_row_addr;
{% if has_onchip_col_repair %}
    logic [DATA_WIDTH-1:0]                                  algo_fail_bitmask;
    logic [{{ redundancy.num_spare_cols }}-1:0]              col_repair_en;
    logic [{{ redundancy.num_spare_cols }}*{{ redundancy.bit_index_width }}-1:0] faulty_bit;
{% endif %}

    assign effective_test_mode  = test_mode || ctrl_test_mode_override;
    assign effective_bist_start = (bist_start && test_mode && !self_repair_busy) || ctrl_bist_start;
{% endif %}
{% if has_onchip_selfrepair and is_shared_bus %}
    // Shared-controller self-repair (docs/shared-hierarchical-mbist-plan.md
    // §9b): one independent onchip_selfrepair_ctrl + onchip_row_repair_analyzer
    // + repair_remap_row per memory (generate loop, below, inside the
    // is_shared_bus block where the outer sequencer lives) -- each memory's
    // own defects are independent, so its own repair state must be too. Only
    // algo_fail_valid/algo_fail_addr stay singular/broadcast: u_algo_top
    // itself is singular (unaware of which memory it's driving, per step 1),
    // so its own per-pass fail report is read by whichever memory's analyzer
    // currently has registrar_enable_arr[mem_sel_q] asserted -- broadcasting
    // is safe here because every OTHER instance's own registrar_enable stays
    // deasserted unless it's genuinely that memory's turn (see §4c's own
    // "broadcast is safe when downstream semantics are gated per-instance"
    // principle). effective_test_mode is declared here too (still singular --
    // one wrapper-level mux signal) but its own assign lives inside the
    // is_shared_bus block below, where shb_selfrepair_mode_q/
    // ctrl_test_mode_override_arr exist -- NOT the assign above, which would
    // be a second, conflicting driver of the same net.
    logic                  algo_fail_valid;
    logic [ADDR_WIDTH-1:0] algo_fail_addr;
    logic                  effective_test_mode;
    logic                  self_repair_start_arr [{{ num_memories }}];
    logic                  self_repair_done_arr  [{{ num_memories }}];
    logic                  self_repair_fail_arr  [{{ num_memories }}];
    logic                  self_repair_busy_arr  [{{ num_memories }}];
    logic                  ctrl_test_mode_override_arr [{{ num_memories }}];
    logic                  ctrl_bist_start_arr   [{{ num_memories }}];
    logic                  registrar_enable_arr  [{{ num_memories }}];
    logic                  latch_result_arr      [{{ num_memories }}];
    logic                  unrepairable_arr       [{{ num_memories }}];
    logic [{{ redundancy.num_spare_rows }}-1:0]            row_repair_en_arr   [{{ num_memories }}];
    logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] faulty_row_addr_arr [{{ num_memories }}];
    logic [{{ redundancy.mem_addr_width }}-1:0]            sram_addr_phys_arr  [{{ num_memories }}];
{% endif %}
{% if is_shared_bus %}
    // Sequences u_algo_top across mem_sel_q = 0..NUM_MEMORIES-1: SHB_RUN holds
    // algo_bist_start high while one memory's pass runs; on algo_bist_done,
    // SHB_ADVANCE drops algo_bist_start for exactly one cycle (forcing
    // u_algo_top's own FSM back to its idle state via its existing
    // bist_start-drop restart path -- no new reset signal needed, see
    // docs/shared-hierarchical-mbist-plan.md §4a) before SHB_RUN re-raises it
    // for the next memory. u_algo_top itself needs zero awareness of which
    // memory it's driving -- this sequencer and the csb/dout mux below sit
    // strictly between it and the memory instantiation(s), and its own
    // address/data/write-enable path (sram_addr/sram_din/sram_we above) is
    // completely unchanged.
    typedef enum logic [1:0] {
        SHB_IDLE,
        SHB_RUN,
        SHB_ADVANCE,
        SHB_DONE
    } shb_state_t;

    shb_state_t             shb_state_q;
    logic [{{ mem_sel_width }}-1:0] mem_sel_q;
    logic                    algo_bist_start;
    logic                    algo_bist_done;
    logic                    algo_bist_fail;
    logic                    shb_fail_q;
    logic                    sram_csb_arr [{{ num_memories }}];
    logic [DATA_WIDTH-1:0]   sram_dout_arr [{{ num_memories }}];
{% if has_onchip_selfrepair %}
    // Second orchestration mode, docs/shared-hierarchical-mbist-plan.md §9b:
    // shb_selfrepair_mode_q, latched only at the SHB_IDLE exit that fires,
    // selects whether SHB_RUN/SHB_DONE are running one plain algo pass per
    // memory (mode_q=0, byte-identical to the has_onchip_selfrepair=false
    // case below) or one full two-pass (analyze+verify) repair sequence per
    // memory (mode_q=1) -- reusing the same four states, since both shapes
    // are "wait for a trigger / run one pass and wait for its own done /
    // advance to the next memory / hold the aggregate result"; only what
    // counts as "this pass is done" and what drives u_algo_top differ.
    logic                    shb_selfrepair_mode_q;
    logic                    shb_selfrepair_done_q;
    logic                    shb_selfrepair_fail_q;

    // One independent onchip_row_repair_analyzer + onchip_selfrepair_ctrl +
    // repair_remap_row per memory -- each reads u_algo_top's own PER-PASS
    // algo_bist_done/algo_bist_fail directly (not the wrapper's aggregate
    // bist_done/bist_fail, which only fires after ALL memories finish).
    // mbist_busy/algo_fail_valid/algo_fail_addr stay singular (u_algo_top's
    // own outputs, broadcast) -- see the declaration block above for why
    // broadcasting fail_valid/fail_addr is safe here.
    genvar gsr;
    generate
      for (gsr = 0; gsr < {{ num_memories }}; gsr++) begin : selfrepair_inst
        onchip_row_repair_analyzer #(
            .ADDR_WIDTH(ADDR_WIDTH),
            .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
        ) u_onchip_analyzer (
            .clk(clk),
            .rst_n(rst_n),
            .enable(registrar_enable_arr[gsr]),
            .fail_valid(algo_fail_valid),
            .fail_addr(algo_fail_addr),
            .latch_result(latch_result_arr[gsr]),
            .repair_load(1'b0),
            .fuse_row_repair_en('0),
            .fuse_faulty_row_addr('0),
            .repair_load_done(),
            .row_repair_en(row_repair_en_arr[gsr]),
            .faulty_row_addr(faulty_row_addr_arr[gsr]),
            .unrepairable(unrepairable_arr[gsr])
        );

        onchip_selfrepair_ctrl u_onchip_selfrepair_ctrl (
            .clk(clk),
            .rst_n(rst_n),
            .self_repair_start(self_repair_start_arr[gsr]),
            .self_repair_done(self_repair_done_arr[gsr]),
            .self_repair_fail(self_repair_fail_arr[gsr]),
            .self_repair_busy(self_repair_busy_arr[gsr]),
            .ctrl_test_mode_override(ctrl_test_mode_override_arr[gsr]),
            .ctrl_bist_start(ctrl_bist_start_arr[gsr]),
            .mbist_busy(mbist_busy),
            .bist_done(algo_bist_done),
            .bist_fail(algo_bist_fail),
            .registrar_enable(registrar_enable_arr[gsr]),
            .latch_result(latch_result_arr[gsr]),
            .unrepairable(unrepairable_arr[gsr])
        );

        repair_remap_row #(
            .ADDR_WIDTH(ADDR_WIDTH),
            .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
        ) u_repair_remap (
            .addr_in(sram_addr),
            .addr_out(sram_addr_phys_arr[gsr])
          , .row_repair_en(row_repair_en_arr[gsr])
          , .faulty_row_addr(faulty_row_addr_arr[gsr])
        );
      end
    endgenerate

    assign algo_bist_start = shb_selfrepair_mode_q
        ? ctrl_bist_start_arr[mem_sel_q]
        : (shb_state_q == SHB_RUN);
    assign effective_test_mode = test_mode
        || (shb_selfrepair_mode_q && ctrl_test_mode_override_arr[mem_sel_q]);
    assign bist_done       = (shb_state_q == SHB_DONE) && !shb_selfrepair_mode_q;
    assign self_repair_busy = shb_selfrepair_mode_q && (shb_state_q != SHB_IDLE);
    assign self_repair_done = shb_selfrepair_done_q;
    assign self_repair_fail = shb_selfrepair_fail_q;
{% for i in range(num_memories) %}
    assign self_repair_start_arr[{{ i }}] =
        shb_selfrepair_mode_q && (shb_state_q != SHB_IDLE) && (mem_sel_q == {{ i }});
{% endfor %}
{% else %}

    assign algo_bist_start = (shb_state_q == SHB_RUN);
    assign bist_done       = (shb_state_q == SHB_DONE);
{% endif %}
    assign bist_fail       = shb_fail_q;
    assign sram_dout       = sram_dout_arr[mem_sel_q];
{% for i in range(num_memories) %}
    assign sram_csb_arr[{{ i }}] = (mem_sel_q == {{ i }}) ? sram_csb : 1'b1;
{% endfor %}

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            shb_state_q <= SHB_IDLE;
            mem_sel_q   <= '0;
            shb_fail_q  <= 1'b0;
{% if has_onchip_selfrepair %}
            shb_selfrepair_mode_q <= 1'b0;
            shb_selfrepair_done_q <= 1'b0;
            shb_selfrepair_fail_q <= 1'b0;
{% endif %}
        end else begin
            case (shb_state_q)
                SHB_IDLE: begin
{% if has_onchip_selfrepair %}
                    if (self_repair_start && !mbist_busy) begin
                        mem_sel_q              <= '0;
                        shb_selfrepair_done_q  <= 1'b0;
                        shb_selfrepair_fail_q  <= 1'b0;
                        shb_selfrepair_mode_q  <= 1'b1;
                        shb_state_q            <= SHB_RUN;
                    end else if (bist_start && test_mode && !self_repair_start) begin
                        mem_sel_q              <= '0;
                        shb_fail_q             <= 1'b0;
                        shb_selfrepair_mode_q  <= 1'b0;
                        shb_state_q            <= SHB_RUN;
                    end
{% else %}
                    if ({{ start_signal }}) begin
                        mem_sel_q   <= '0;
                        shb_fail_q  <= 1'b0;
                        shb_state_q <= SHB_RUN;
                    end
{% endif %}
                end
                SHB_RUN: begin
{% if has_onchip_selfrepair %}
                    if (shb_selfrepair_mode_q) begin
                        if (self_repair_done_arr[mem_sel_q]) begin
                            if (self_repair_fail_arr[mem_sel_q])
                                shb_selfrepair_fail_q <= 1'b1;
                            if (mem_sel_q == {{ num_memories - 1 }}) begin
                                shb_selfrepair_done_q <= 1'b1;
                                shb_state_q            <= SHB_DONE;
                            end else begin
                                shb_state_q <= SHB_ADVANCE;
                            end
                        end
                    end else begin
                        if (algo_bist_done) begin
                            if (algo_bist_fail) shb_fail_q <= 1'b1;
                            if (mem_sel_q == {{ num_memories - 1 }})
                                shb_state_q <= SHB_DONE;
                            else
                                shb_state_q <= SHB_ADVANCE;
                        end
                    end
{% else %}
                    if (algo_bist_done) begin
                        if (algo_bist_fail) shb_fail_q <= 1'b1;
                        if (mem_sel_q == {{ num_memories - 1 }})
                            shb_state_q <= SHB_DONE;
                        else
                            shb_state_q <= SHB_ADVANCE;
                    end
{% endif %}
                end
                SHB_ADVANCE: begin
                    mem_sel_q   <= mem_sel_q + 1'b1;
                    shb_state_q <= SHB_RUN;
                end
                SHB_DONE: begin
{% if has_onchip_selfrepair %}
                    if (shb_selfrepair_mode_q) begin
                        if (!self_repair_start) shb_state_q <= SHB_IDLE;
                    end else begin
                        if (!(bist_start && test_mode)) shb_state_q <= SHB_IDLE;
                    end
{% else %}
                    // Parenthesized: start_signal (bist_start && test_mode in
                    // the non-self-repair case) must be negated as a whole --
                    // !bist_start && test_mode is NOT !(bist_start && test_mode).
                    if (!({{ start_signal }})) shb_state_q <= SHB_IDLE;
{% endif %}
                end
                default: shb_state_q <= SHB_IDLE;
            endcase
        end
    end
{% endif %}

    {{ algo_top_module }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .READ_LATENCY({{ read_latency }})
    ) u_algo_top (
        .clk(clk),
        .rst_n(rst_n),
{% if is_shared_bus %}
        .bist_start(algo_bist_start),
        .bist_busy(mbist_busy),
        .bist_done(algo_bist_done),
        .bist_fail(algo_bist_fail),
{% else %}
        .bist_start({{ start_signal }}),
        .bist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
{% endif %}
{% if has_onchip_selfrepair %}
        .bist_fail_valid(algo_fail_valid),
        .bist_fail_addr(algo_fail_addr),
{% endif %}
{% if has_onchip_col_repair %}
        .bist_fail_bitmask(algo_fail_bitmask),
{% endif %}
        .sram_clk0(mbist_sram_clk),
        .sram_csb0(mbist_sram_csb),
        .sram_web0(mbist_sram_web),
        .sram_addr0(mbist_sram_addr),
        .sram_din0(mbist_sram_din),
        .sram_dout0(sram_dout)
    );

    assign mbist_write_req    = ~mbist_sram_web;
    assign selected_write_req = {{ mode_signal }} ? mbist_write_req : func_we;

{% if we_active_low %}
    assign sram_we = ~selected_write_req;
{% else %}
    assign sram_we = selected_write_req;
{% endif %}

    assign sram_addr = {{ mode_signal }} ? mbist_sram_addr : func_addr;
    assign sram_din  = {{ mode_signal }} ? mbist_sram_din : func_din;
    assign sram_csb  = {{ mode_signal }} ? mbist_sram_csb : func_csb;
    assign func_dout = sram_dout;

{% if use_saboteur %}
    {% for pname, pdata in normalized_ports.items() %}
    {{ memory_name }}_saboteur #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout),
        .dbg_actual_word(sram_dbg_actual_word),
        .dbg_fault_word(sram_dbg_fault_word),
        .dbg_intended_word(sram_dbg_intended_word),
        .dbg_prior_value(sram_dbg_prior_value),
        .dbg_attempted_write(sram_dbg_attempted_write),
        .dbg_actual_read(sram_dbg_actual_read),
        .dbg_blocked_bits(sram_dbg_blocked_bits)
    );
    {% endfor %}
{% else %}
    {% for pname, pdata in normalized_ports.items() %}
{% if has_redundancy %}
{% if has_onchip_selfrepair and not is_shared_bus %}
    // Row redundancy (on-chip self-repair): an EXTERNAL repair remap sits between
    // the address mux and a stock spare-augmented memory. An on-chip analyzer +
    // sequencer compute and apply the repair signature autonomously -- no
    // repair_ports/tester involvement (mutually exclusive by config validation).
    // (algo_fail_valid/algo_fail_addr/effective_test_mode/effective_bist_start/
    // row_repair_en/faulty_row_addr etc. are declared earlier, alongside
    // mbist_busy -- Icarus needs the declaration to precede u_algo_top's
    // instantiation and the test_mode mux, both of which come before this.)
    logic [{{ redundancy.mem_addr_width }}-1:0] sram_addr_phys;
{% if has_onchip_col_repair %}
    // Column redundancy (on-chip 2D analyzer): same DATA-path remap shape as the
    // tester-driven column path below, but sourced from col_repair_en/faulty_bit
    // computed on-chip by u_onchip_analyzer instead of repair_ports boundary pins.
    logic [{{ redundancy.mem_data_width }}-1:0] sram_din_phys;
    logic [{{ redundancy.mem_data_width }}-1:0] sram_dout_phys;
    logic [{{ redundancy.num_spare_cols }}-1:0] sram_spare_wen;
{% endif %}

{% if has_onchip_col_repair %}
    onchip_2d_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }}),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .fail_bitmask(algo_fail_bitmask),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .col_repair_en(col_repair_en),
        .faulty_bit(faulty_bit),
        .unrepairable(unrepairable)
    );
{% else %}
    onchip_row_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .unrepairable(unrepairable)
    );
{% endif %}

{% if has_onchip_diagnosis %}
    onchip_diagnosis_log #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_DIAGNOSIS_ENTRIES({{ redundancy.num_diagnosis_entries }})
    ) u_onchip_diagnosis (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
        .diag_valid(diag_valid),
        .diag_addr(diag_addr),
        .diag_overflow(diag_overflow)
    );

{% endif %}
    onchip_selfrepair_ctrl u_onchip_selfrepair_ctrl (
        .clk(clk),
        .rst_n(rst_n),
        .self_repair_start(self_repair_start),
        .self_repair_done(self_repair_done),
        .self_repair_fail(self_repair_fail),
        .self_repair_busy(self_repair_busy),
        .ctrl_test_mode_override(ctrl_test_mode_override),
        .ctrl_bist_start(ctrl_bist_start),
        .mbist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
        .registrar_enable(registrar_enable),
        .latch_result(latch_result),
        .unrepairable(unrepairable)
    );

    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap (
        .addr_in(sram_addr),
        .addr_out(sram_addr_phys)
      , .row_repair_en(row_repair_en)
      , .faulty_row_addr(faulty_row_addr)
    );
{% if has_onchip_col_repair %}

    repair_remap_col #(
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_repair_remap_col (
        .din_in(sram_din),
        .din_out(sram_din_phys),
        .dout_in(sram_dout_phys),
        .dout_out(sram_dout),
        .spare_wen(sram_spare_wen),
        .col_repair_en(col_repair_en),
        .faulty_bit(faulty_bit)
    );
{% endif %}
{% elif has_onchip_selfrepair and is_shared_bus %}
    // Shared-controller self-repair (docs/shared-hierarchical-mbist-plan.md
    // §9b): the per-memory analyzer/ctrl/remap instances already exist above,
    // inside the is_shared_bus generate loop (selfrepair_inst) -- nothing to
    // instantiate here. sram_addr_phys_arr (declared alongside that loop) is
    // what the memory instantiation below reads.
{% else %}
    // Row redundancy: an EXTERNAL repair remap sits between the address mux and a
    // stock spare-augmented memory. The repair_ports pins drive the remap (not the
    // memory, which has no repair pins); the memory just sees the remapped address.
    logic [{{ redundancy.mem_addr_width }}-1:0] sram_addr_phys;

    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap (
        .addr_in(sram_addr),
        .addr_out(sram_addr_phys)
{% for rp in repair_ports if rp.bind != 'col' %}
      , .{{ rp.name }}({{ rp.name }})
{% endfor %}
    );
{% if has_col_repair %}

    // Column redundancy: a second EXTERNAL remap on the DATA path, steering the
    // bits marked faulty onto spare columns. Independent of the row remap above
    // (that one is address-only, this one is data-only), so the two compose:
    // a row-steered access still gets its column steer, on the spare row's own
    // spare columns. sram_dout is driven from HERE, not from the memory -- the
    // memory drives sram_dout_phys instead.
    //
    // These widths are generator-time CONSTANTS, baked from the config's
    // data_width -- they do not track an ADDR_WIDTH/DATA_WIDTH override at
    // instantiation, and neither does the faulty_bit boundary port (whose width
    // comes from the repair_ports entry). That matches sram_addr_phys above and
    // the memory instantiation itself: a generated wrapper is built FOR one
    // memory geometry, and its parameters document that geometry rather than
    // resize it. Overriding them at instantiation was never supported.
    logic [{{ redundancy.mem_data_width }}-1:0] sram_din_phys;
    logic [{{ redundancy.mem_data_width }}-1:0] sram_dout_phys;
    logic [{{ redundancy.num_spare_cols }}-1:0] sram_spare_wen;

    repair_remap_col #(
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_repair_remap_col (
        .din_in(sram_din),
        .din_out(sram_din_phys),
        .dout_in(sram_dout_phys),
        .dout_out(sram_dout),
        .spare_wen(sram_spare_wen)
{% for rp in repair_ports if rp.bind == 'col' %}
      , .{{ rp.name }}({{ rp.name }})
{% endfor %}
    );
{% endif %}
{% endif %}

{% if is_shared_bus %}
{% for mem in memories %}
{% if memory_has_fixed_geometry %}
    // memory_has_fixed_geometry: see the note on the redundancy instantiation
    // above -- a real compiled macro keeps its own widths.
    {{ memory_name }} u_mem_{{ mem.name }} (
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_mem_{{ mem.name }} (
{% endif %}
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb_arr[{{ loop.index0 }}]),
        .{{ pdata.addr }}(sram_addr_phys_arr[{{ loop.index0 }}]),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout_arr[{{ loop.index0 }}])
{% if pdata.spare_wen %}
      // Macro has a spare-column write enable but this combination
      // (shared-bus self-repair) is row-only for now -- column repair under
      // shared-bus is a separate, not-yet-scoped follow-up (docs/shared-
      // hierarchical-mbist-plan.md §9b). Tie it off rather than leave a real
      // macro's input floating -- '0 disables spare-column writes.
      , .{{ pdata.spare_wen }}('0)
{% endif %}
    );
{% endfor %}
{% elif memory_has_fixed_geometry %}
    // memory_has_fixed_geometry: the memory's widths are compiled in (a real
    // OpenRAM macro), so no parameter overrides -- passing them would resize a
    // behavioural model away from the geometry that would actually be built.
    {{ memory_name }} u_sram (
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
{% if has_col_repair %}
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }}),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
{% else %}
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
{% endif %}
    ) u_sram (
{% endif %}
{% if not is_shared_bus %}
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr_phys),
{% if has_col_repair %}
        .{{ pdata.din }}(sram_din_phys),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout_phys),
        .{{ pdata.spare_wen }}(sram_spare_wen)
{% else %}
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout)
{% if pdata.spare_wen %}
      // Macro has a spare-column write enable but this design does not use
      // column repair. Tie it off rather than leave a real macro's input
      // floating -- '0 disables spare-column writes.
      , .{{ pdata.spare_wen }}('0)
{% endif %}
{% endif %}
    );
{% endif %}
{% else %}
{% if is_shared_bus %}
{% for mem in memories %}
{% if memory_has_fixed_geometry %}
    // memory_has_fixed_geometry: see the note on the redundancy instantiation
    // above -- a real compiled macro keeps its own widths.
    {{ memory_name }} u_mem_{{ mem.name }} (
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_mem_{{ mem.name }} (
{% endif %}
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb_arr[{{ loop.index0 }}]),
        .{{ pdata.addr }}(sram_addr),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout_arr[{{ loop.index0 }}])
{% if pdata.spare_wen %}
      // Macro has a spare-column write enable but this design has no
      // redundancy at all. Tie it off rather than leave a real macro's
      // input floating -- '0 disables spare-column writes.
      , .{{ pdata.spare_wen }}('0)
{% endif %}
    );
{% endfor %}
{% else %}
{% if memory_has_fixed_geometry %}
    // memory_has_fixed_geometry: see the note on the redundancy instantiation
    // above -- a real compiled macro keeps its own widths.
    {{ memory_name }} u_sram (
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
{% endif %}
        .{{ pdata.clk }}(mbist_sram_clk),
        .{{ pdata.csb }}(sram_csb),
        .{{ pdata.addr }}(sram_addr),
        .{{ pdata.din }}(sram_din),
        .{{ pdata.we }}(sram_we),
        .{{ pdata.dout }}(sram_dout)
{% if pdata.spare_wen %}
      // Macro has a spare-column write enable but this design has no
      // redundancy at all. Tie it off rather than leave a real macro's
      // input floating -- '0 disables spare-column writes.
      , .{{ pdata.spare_wen }}('0)
{% endif %}
    );
{% endif %}
{% endif %}
    {% endfor %}
{% endif %}
{% else %}
    logic mbist_busy;

{% if has_onchip_selfrepair %}
    // On-chip self-repair (march-1r1w): declared here (not alongside their
    // instantiations below) because Icarus requires a wire's declaration to
    // textually precede its use, and these are read by u_algo_top's
    // instantiation and the {{ mode_signal }} muxes immediately below -- both
    // ahead of where the modules that drive them are instantiated.
    logic                  algo_fail_valid;
    logic [ADDR_WIDTH-1:0] algo_fail_addr;
    logic                  effective_test_mode;
    logic                  effective_bist_start;
    logic                  ctrl_test_mode_override;
    logic                  ctrl_bist_start;
    logic                  registrar_enable;
    logic                  latch_result;
    logic                  unrepairable;
    logic [{{ redundancy.num_spare_rows }}-1:0]            row_repair_en;
    logic [{{ redundancy.num_spare_rows }}*ADDR_WIDTH-1:0] faulty_row_addr;
{% if has_onchip_col_repair %}
    logic [DATA_WIDTH-1:0]                                  algo_fail_bitmask;
    logic [{{ redundancy.num_spare_cols }}-1:0]              col_repair_en;
    logic [{{ redundancy.num_spare_cols }}*{{ redundancy.bit_index_width }}-1:0] faulty_bit;
{% if has_dual_rw_col_repair %}
    // TWO independent spare_wen wires, one per port: march-2rw's ports are
    // both fully read/write and independently commit their own writes (see
    // the per-port repair_remap_col instances below), so there is no single
    // shared spare_wen source the way the r+w (march-1r1w) shape has.
    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    logic [{{ redundancy.num_spare_cols }}-1:0]              sram_spare_wen{{ suffix }};
    {% endfor %}
{% else %}
    // Single, non-suffixed wire: ONE repair_remap_col instance serves the
    // whole design (col_repair_en/faulty_bit are shared claims, independent
    // of which physical port a given bit's read/write happens to land on),
    // so there is exactly one spare_wen source -- wired out to whichever
    // port declares the spare_wen role in the memory instantiation below.
    logic [{{ redundancy.num_spare_cols }}-1:0]              sram_spare_wen;
{% endif %}
{% endif %}

    assign effective_test_mode  = test_mode || ctrl_test_mode_override;
    assign effective_bist_start = (bist_start && test_mode && !self_repair_busy) || ctrl_bist_start;

{% endif %}
    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    logic                  mbist_sram_clk{{ suffix }};
    logic                  mbist_sram_csb{{ suffix }};
    {% if pdata.type in ("w", "rw") %}
    logic                  mbist_sram_web{{ suffix }};
    {% endif %}
    logic [ADDR_WIDTH-1:0] mbist_sram_addr{{ suffix }};
    {% if pdata.type in ("w", "rw") %}
    logic [DATA_WIDTH-1:0] mbist_sram_din{{ suffix }};
    {% endif %}
    {% if pdata.type in ("r", "rw") %}
    logic [DATA_WIDTH-1:0] sram_dout{{ suffix }};
    {% if has_onchip_col_repair %}
    logic [{{ redundancy.mem_data_width }}-1:0] sram_dout_phys{{ suffix }};
    {% endif %}
    {% endif %}
    logic [ADDR_WIDTH-1:0] sram_addr{{ suffix }};
    {% if has_onchip_selfrepair %}
    logic [{{ redundancy.mem_addr_width }}-1:0] sram_addr_phys{{ suffix }};
    {% endif %}
    {% if pdata.type in ("w", "rw") %}
    logic [DATA_WIDTH-1:0] sram_din{{ suffix }};
    {% if has_onchip_col_repair %}
    logic [{{ redundancy.mem_data_width }}-1:0] sram_din_phys{{ suffix }};
    {% endif %}
    logic                  sram_we{{ suffix }};
    logic                  selected_write_req{{ suffix }};
    logic                  mbist_write_req{{ suffix }};
    {% endif %}
    logic                  sram_csb{{ suffix }};
    {% endfor %}

    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    {% if pdata.type == "r" or (pdata.type == "rw" and suffix == "0") %}
    logic [DATA_WIDTH-1:0] sram_dbg_actual_word;
    logic [DATA_WIDTH-1:0] sram_dbg_fault_word;
    logic [DATA_WIDTH-1:0] sram_dbg_intended_word;
    logic [DATA_WIDTH-1:0] sram_dbg_prior_value;
    logic [DATA_WIDTH-1:0] sram_dbg_attempted_write;
    logic [DATA_WIDTH-1:0] sram_dbg_actual_read;
    logic [DATA_WIDTH-1:0] sram_dbg_blocked_bits;
    {% endif %}
    {% endfor %}

    {{ algo_top_module }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .READ_LATENCY({{ read_latency }})
    ) u_algo_top (
        .clk(clk),
        .rst_n(rst_n),
        .bist_start({{ start_signal }}),
        .bist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
{% if has_onchip_selfrepair %}
        .bist_fail_valid(algo_fail_valid),
        .bist_fail_addr(algo_fail_addr),
{% endif %}
{% if has_onchip_col_repair %}
        .bist_fail_bitmask(algo_fail_bitmask),
{% endif %}
        {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% if pdata.type == "r" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_dout{{ suffix }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "w" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_web{{ suffix }}(mbist_sram_web{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_din{{ suffix }}(mbist_sram_din{{ suffix }}){{ "," if not loop.last }}
        {% elif pdata.type == "rw" %}
        .sram_clk{{ suffix }}(mbist_sram_clk{{ suffix }}),
        .sram_csb{{ suffix }}(mbist_sram_csb{{ suffix }}),
        .sram_web{{ suffix }}(mbist_sram_web{{ suffix }}),
        .sram_addr{{ suffix }}(mbist_sram_addr{{ suffix }}),
        .sram_din{{ suffix }}(mbist_sram_din{{ suffix }}),
        .sram_dout{{ suffix }}(sram_dout{{ suffix }}){{ "," if not loop.last }}
        {% endif %}
        {% endfor %}
    );

    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    {% if pdata.type == "w" %}
    assign mbist_write_req{{ suffix }}    = ~mbist_sram_web{{ suffix }};
    assign selected_write_req{{ suffix }} = {{ mode_signal }} ? mbist_write_req{{ suffix }} : func_we;

    {% if we_active_low %}
    assign sram_we{{ suffix }} = ~selected_write_req{{ suffix }};
    {% else %}
    assign sram_we{{ suffix }} = selected_write_req{{ suffix }};
    {% endif %}

    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_din{{ suffix }}  = {{ mode_signal }} ? mbist_sram_din{{ suffix }} : func_din;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    {% elif pdata.type == "rw" %}
    assign mbist_write_req{{ suffix }}    = ~mbist_sram_web{{ suffix }};
    assign selected_write_req{{ suffix }} = {{ mode_signal }} ? mbist_write_req{{ suffix }} : func_we;

    {% if we_active_low %}
    assign sram_we{{ suffix }} = ~selected_write_req{{ suffix }};
    {% else %}
    assign sram_we{{ suffix }} = selected_write_req{{ suffix }};
    {% endif %}

    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_din{{ suffix }}  = {{ mode_signal }} ? mbist_sram_din{{ suffix }} : func_din;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    {% if suffix == "0" %}
    // march-2rw's functional boundary is inherently single-port: only the
    // port assigned suffix "0" drives func_dout in functional (test_mode=0)
    // mode. The second port exists for the MBIST algorithm's internal
    // concurrency (e.g. concurrent read+write to different/same addresses),
    // not for external dual-port functional access.
    assign func_dout = sram_dout{{ suffix }};
    {% endif %}
    {% else %}
    assign sram_addr{{ suffix }} = {{ mode_signal }} ? mbist_sram_addr{{ suffix }} : func_addr;
    assign sram_csb{{ suffix }}  = {{ mode_signal }} ? mbist_sram_csb{{ suffix }} : func_csb;
    assign func_dout = sram_dout{{ suffix }};
    {% endif %}
    {% endfor %}

{% if has_onchip_selfrepair %}
    // On-chip self-repair: one external repair remap PER PORT, each steering
    // that port's own address independently. This is general on purpose, not
    // special-cased per algo -- march-1r1w's two ports happen to always carry
    // the identical logical address (one shared addr_q, no partner-address
    // concept anywhere in march_1r1w_fsm.sv), so its second remap instance is
    // a provably harmless duplicate, not a structural requirement. march-2rw's
    // ports do NOT share an address in general (addr_q vs.
    // addr_q ^ PARTNER_XOR under use_partner_addr1) -- collapsing both onto
    // one remap fed by only one port's address would silently discard the
    // other port's real address the moment self-repair is enabled, corrupting
    // normal dual-port addressing, not just leaving repair redirection
    // incomplete. repair_remap_row is purely combinational and deterministic,
    // so every instance sees the SAME row_repair_en/faulty_row_addr from the
    // one analyzer below and remaps consistently.
{% if has_onchip_col_repair %}
    // Column repair, unlike the row remap above, is NOT per-port:
    // col_repair_en/faulty_bit are a single set of claims fed into one
    // repair_remap_col instance below, wired across whichever port
    // physically reads and whichever physically writes.
    onchip_2d_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }}),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .fail_bitmask(algo_fail_bitmask),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .col_repair_en(col_repair_en),
        .faulty_bit(faulty_bit),
        .unrepairable(unrepairable)
    );
{% else %}
    onchip_row_repair_analyzer #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_onchip_analyzer (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
{% if has_onchip_repair_persistence %}
        .repair_load(repair_load),
        .fuse_row_repair_en(fuse_row_repair_en),
        .fuse_faulty_row_addr(fuse_faulty_row_addr),
        .repair_load_done(repair_load_done),
{% else %}
        .repair_load(1'b0),
        .fuse_row_repair_en('0),
        .fuse_faulty_row_addr('0),
        .repair_load_done(),
{% endif %}
        .row_repair_en(row_repair_en),
        .faulty_row_addr(faulty_row_addr),
        .unrepairable(unrepairable)
    );
{% endif %}

{% if has_onchip_diagnosis %}
    onchip_diagnosis_log #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_DIAGNOSIS_ENTRIES({{ redundancy.num_diagnosis_entries }})
    ) u_onchip_diagnosis (
        .clk(clk),
        .rst_n(rst_n),
        .enable(registrar_enable),
        .fail_valid(algo_fail_valid),
        .fail_addr(algo_fail_addr),
        .latch_result(latch_result),
        .diag_valid(diag_valid),
        .diag_addr(diag_addr),
        .diag_overflow(diag_overflow)
    );

{% endif %}
    onchip_selfrepair_ctrl u_onchip_selfrepair_ctrl (
        .clk(clk),
        .rst_n(rst_n),
        .self_repair_start(self_repair_start),
        .self_repair_done(self_repair_done),
        .self_repair_fail(self_repair_fail),
        .self_repair_busy(self_repair_busy),
        .ctrl_test_mode_override(ctrl_test_mode_override),
        .ctrl_bist_start(ctrl_bist_start),
        .mbist_busy(mbist_busy),
        .bist_done(bist_done),
        .bist_fail(bist_fail),
        .registrar_enable(registrar_enable),
        .latch_result(latch_result),
        .unrepairable(unrepairable)
    );

    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    repair_remap_row #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
    ) u_repair_remap{{ suffix }} (
        .addr_in(sram_addr{{ suffix }})
      , .addr_out(sram_addr_phys{{ suffix }})
      , .row_repair_en(row_repair_en)
      , .faulty_row_addr(faulty_row_addr)
    );
    {% endfor %}
{% if has_onchip_col_repair %}
{% if has_dual_rw_col_repair %}
    // Column redundancy: march-2rw's two ports are BOTH fully read/write and
    // can target DIFFERENT addresses the same cycle (E1/E4: port0 writes
    // addr_q, port1 writes partner_addr) -- no single reader/writer to
    // cross-wire one shared instance onto, unlike march-1r1w. Column
    // steering is address-independent (repair_remap_col has no address
    // input), so two fully independent instances compose safely: each
    // port's own instance only needs that port's own din_in/dout_in. Both
    // share col_repair_en/faulty_bit (one analyzer, one set of claims -- a
    // column claim is a property of a bit lane, not a port), but each has
    // ITS OWN spare_wen, since each port independently commits its own
    // writes (sram_model_2rw.sv).
    {% for pname, pdata in normalized_ports.items() %}
    {% set suffix = algo_port_suffixes[pname] %}
    repair_remap_col #(
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_repair_remap_col{{ suffix }} (
        .din_in(sram_din{{ suffix }}),
        .din_out(sram_din_phys{{ suffix }}),
        .dout_in(sram_dout_phys{{ suffix }}),
        .dout_out(sram_dout{{ suffix }}),
        .spare_wen(sram_spare_wen{{ suffix }}),
        .col_repair_en(col_repair_en),
        .faulty_bit(faulty_bit)
    );
    {% endfor %}
{% else %}
{% set ns = namespace(read_suffix=None, write_suffix=None) %}
{% for pname, pdata in normalized_ports.items() %}
{% set suffix = algo_port_suffixes[pname] %}
{% if pdata.type in ("r", "rw") %}
{% set ns.read_suffix = suffix %}
{% endif %}
{% if pdata.type in ("w", "rw") %}
{% set ns.write_suffix = suffix %}
{% endif %}
{% endfor %}
    // Column redundancy: ONE repair_remap_col instance, cross-wired across
    // whichever port physically writes (its logical sram_din feeds din_in,
    // its physical sram_din_phys receives din_out and spare_wen) and
    // whichever physically reads (its physical sram_dout_phys feeds dout_in,
    // its logical sram_dout receives dout_out). Not per-port like
    // repair_remap_row above -- a column claim is a property of a BIT LANE,
    // not of a port, so one instance covers every port that touches data.
    // (This read_suffix/write_suffix pairing is exact for march-1r1w's one
    // read-only + one write-only port; march-2rw's two "rw" ports use a
    // per-port instance instead, see the sibling branch above.)
    repair_remap_col #(
        .DATA_WIDTH(DATA_WIDTH),
        .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
    ) u_repair_remap_col (
        .din_in(sram_din{{ ns.write_suffix }}),
        .din_out(sram_din_phys{{ ns.write_suffix }}),
        .dout_in(sram_dout_phys{{ ns.read_suffix }}),
        .dout_out(sram_dout{{ ns.read_suffix }}),
        .spare_wen(sram_spare_wen),
        .col_repair_en(col_repair_en),
        .faulty_bit(faulty_bit)
    );
{% endif %}
{% endif %}

{% endif %}
{% if use_saboteur %}
    {{ memory_name }}_saboteur #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
    ) u_sram (
    {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% if pdata.type == "r" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}),
        {% elif pdata.type == "w" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.din }}(sram_din{{ suffix }}),
        {% elif pdata.type == "rw" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}(sram_addr{{ suffix }}),
        .{{ pdata.din }}(sram_din{{ suffix }}),
        .{{ pdata.dout }}(sram_dout{{ suffix }}),
        {% endif %}
    {% endfor %}
        .dbg_actual_word(sram_dbg_actual_word),
        .dbg_fault_word(sram_dbg_fault_word),
        .dbg_intended_word(sram_dbg_intended_word),
        .dbg_prior_value(sram_dbg_prior_value),
        .dbg_attempted_write(sram_dbg_attempted_write),
        .dbg_actual_read(sram_dbg_actual_read),
        .dbg_blocked_bits(sram_dbg_blocked_bits)
    );
{% else %}
{% if memory_has_fixed_geometry %}
    // memory_has_fixed_geometry: a real compiled macro keeps its own widths.
    {{ memory_name }} u_sram (
{% else %}
    {{ memory_name }} #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH)
{% if has_onchip_selfrepair %}
      , .NUM_SPARE_ROWS({{ redundancy.num_spare_rows }})
{% endif %}
{% if has_onchip_col_repair %}
      , .NUM_SPARE_COLS({{ redundancy.num_spare_cols }})
{% endif %}
    ) u_sram (
{% endif %}
    {% for pname, pdata in normalized_ports.items() %}
        {% set suffix = algo_port_suffixes[pname] %}
        {% set port_addr = ("sram_addr_phys" ~ suffix) if has_onchip_selfrepair else ("sram_addr" ~ suffix) %}
        {% set port_dout = ("sram_dout_phys" ~ suffix) if has_onchip_col_repair else ("sram_dout" ~ suffix) %}
        {% set port_din = ("sram_din_phys" ~ suffix) if has_onchip_col_repair else ("sram_din" ~ suffix) %}
        {% set port_spare_wen = (("sram_spare_wen" ~ suffix) if has_dual_rw_col_repair else "sram_spare_wen") if has_onchip_col_repair else "'0" %}
        {% if pdata.type == "r" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        .{{ pdata.dout }}({{ port_dout }}){{ "," if not loop.last }}
        {% elif pdata.type == "w" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        {% if pdata.spare_wen %}
        .{{ pdata.spare_wen }}({{ port_spare_wen }}),{{ "   // tied off: no column repair on this design" if not has_onchip_col_repair }}
        {% endif %}
        .{{ pdata.din }}({{ port_din }}){{ "," if not loop.last }}
        {% elif pdata.type == "rw" %}
        .{{ pdata.clk }}(mbist_sram_clk{{ suffix }}),
        .{{ pdata.csb }}(sram_csb{{ suffix }}),
        .{{ pdata.we }}(sram_we{{ suffix }}),
        .{{ pdata.addr }}({{ port_addr }}),
        .{{ pdata.din }}({{ port_din }}),
        {% if pdata.spare_wen %}
        .{{ pdata.spare_wen }}({{ port_spare_wen }}),{{ "   // tied off: no column repair on this design" if not has_onchip_col_repair }}
        {% endif %}
        .{{ pdata.dout }}({{ port_dout }}){{ "," if not loop.last }}
        {% endif %}
    {% endfor %}
    );
{% endif %}
{% endif %}

endmodule
