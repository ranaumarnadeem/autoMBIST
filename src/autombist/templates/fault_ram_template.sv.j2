// fault_ram.sv (generated by autombist from a fault-primitive registry)
// Fault-injectable behavioral RAM for MBIST algorithm validation.
//
{% if num_ports == 2 %}
// Two-port synchronous RAM, registered dout per port, 1-cycle read latency.
// Active-low control (csb0/csb1, web0/web1), bit-level write mask per port.
// Port 0: clk0/csb0/web0/wmask0/addr0/din0/dout0.
// Port 1: clk1/csb1/web1/wmask1/addr1/din1/dout1.
{% else %}
// Single-port synchronous RAM, registered dout, 1-cycle read latency.
// Active-low control (csb, web), bit-level write mask.
{% endif %}
//
// Fault list:   +FAULTS=<file>       (omit for golden run)
// Single fault: +FAULT_INDEX=<n>     (0-based line among parsed faults; -1 = all, default)
// Init value:   +INIT=<0|1>          (default 1)
// Verbose:      +FAULT_VERBOSE       (per-fault activation counts at end of sim)
//
{% if num_ports == 2 %}
// Fault line format (decimal, '#' comments):
//   TYPE  VADDR VBIT  AADDR ABIT  P0 P1  [VPORT [APORT]]
// VPORT/APORT are optional and default to 0 when absent.
//
// APORT selects which port's access the AGGRESSOR condition is matched against,
// via `FQ[i].ap != port` -- see write_op()/read_op()'s `port` parameter below.
// It is honoured by CFIN/CFID (write-aggressor loop) and CFDS (both loops).
// NOT by CFST: CFST is a static clamp, and clamp_static() re-asserts storage on
// every access with no port in scope, so a per-port gate has nowhere to sit.
//
// VPORT is parsed into FQ[i].vp but NOT YET HONOURED -- no expression in this
// module reads it, so setting it is currently a no-op for every fault type. The
// victim-side guards match on address/bit alone. Reserved for a future
// per-port victim gate; do not rely on it to scope a fault today.
{% else %}
// Fault line format (decimal, '#' comments):
//   TYPE  VADDR VBIT  AADDR ABIT  P0 P1
{% endif %}

`timescale 1ns/1ps

module fault_ram #(
  parameter int ADDR_WIDTH = 8,
  parameter int DATA_WIDTH = 8,
  parameter int DEPTH      = 1 << ADDR_WIDTH,
  parameter int WORDS_PER_ROW = 1   // HSD (Workstream L): row(addr) = addr /
                                      // WORDS_PER_ROW. Default 1 makes HSD
                                      // provably inert -- see fault_ram.sv's
                                      // identical parameter for the full
                                      // rationale (kept in sync manually).
)(
{% if num_ports == 2 %}
  input  logic                    clk0,
  input  logic                    csb0,   // active low chip select, port 0
  input  logic                    web0,   // active low write enable, port 0 (0 = write, 1 = read)
  input  logic [DATA_WIDTH-1:0]   wmask0, // bit-level write mask, port 0 (1 = write this bit)
  input  logic [ADDR_WIDTH-1:0]   addr0,
  input  logic [DATA_WIDTH-1:0]   din0,
  output logic [DATA_WIDTH-1:0]   dout0,

  input  logic                    clk1,
  input  logic                    csb1,   // active low chip select, port 1
  input  logic                    web1,   // active low write enable, port 1 (0 = write, 1 = read)
  input  logic [DATA_WIDTH-1:0]   wmask1, // bit-level write mask, port 1 (1 = write this bit)
  input  logic [ADDR_WIDTH-1:0]   addr1,
  input  logic [DATA_WIDTH-1:0]   din1,
  output logic [DATA_WIDTH-1:0]   dout1
{% else %}
  input  logic                    clk,
  input  logic                    csb,    // active low chip select
  input  logic                    web,    // active low write enable (0 = write, 1 = read)
  input  logic [DATA_WIDTH-1:0]   wmask,  // bit-level write mask (1 = write this bit)
  input  logic [ADDR_WIDTH-1:0]   addr,
  input  logic [DATA_WIDTH-1:0]   din,
  output logic [DATA_WIDTH-1:0]   dout
{% endif %}
);

  // ---------------- fault type codes (generated from the registry) ----------------
{% for name, code in type_table %}
  localparam int T_{{ name }} = {{ code }};
{% endfor %}

  typedef struct {
    int t;      // type code
    int va, vb; // victim address / bit
    int aa, ab; // aggressor address / bit (coupling, alias target)
    int p0, p1; // type-specific parameters
{% if num_ports == 2 %}
    int vp, ap; // victim / aggressor port (0 or 1), default 0 when a fault
                // line omits the trailing fields. `ap` gates the aggressor
                // match for CFIN/CFID (write-aggressor loop) and CFDS (both
                // loops) -- NOT for CFST, whose arm sits in the portless
                // clamp_static(). `vp` is parsed but read by nothing in this
                // module; see the header. Every non-coupling fault type is
                // port-agnostic by construction.
{% endif %}
    int hits;   // activation count
  } fault_s;

  fault_s FQ[$];
  string  FNAME[$];   // parallel: original type string for reporting

  logic [DATA_WIDTH-1:0] mem [0:DEPTH-1];

  // ---------------- fault list loading ----------------
  function automatic int type_code(string s);
{% for name, code in type_table %}
    if (s == "{{ name }}") return T_{{ name }};
{% endfor %}
    return -1;
  endfunction

  int init_val;

  initial begin
    string  fpath, line, ts;
    int     fd, n, idx, sel;
    fault_s f;

    if (!$value$plusargs("INIT=%d", init_val)) init_val = 1;
    for (int a = 0; a < DEPTH; a++) mem[a] = {DATA_WIDTH{init_val[0]}};
{% if num_ports == 2 %}
    dout0 = '0;
    dout1 = '0;
{% else %}
    dout = '0;
{% endif %}

    if ($value$plusargs("FAULTS=%s", fpath)) begin
      fd = $fopen(fpath, "r");
      if (fd == 0) begin
        $display("FATAL: cannot open fault file %s", fpath);
        $finish;
      end
      idx = 0;
      while ($fgets(line, fd) != 0) begin
{% if num_ports == 2 %}
        // Try the extended 9-field format (with trailing VPORT/APORT) first;
        // fall back to the plain 7-field format when the line doesn't carry
        // them. Verilator's $sscanf returns -1 (not a partial match count)
        // when the format string requests more items than the line has, so
        // a single 9-item scan cannot parse a plain 7-field line -- every
        // pre-multi-port fault file (and every FaultRecord serialized with
        // vport==aport==0, the default) uses that plain 7-field shape.
        f.vp = 0; f.ap = 0;   // defaults when the trailing port fields are absent
        n = $sscanf(line, "%s %d %d %d %d %d %d %d %d",
                    ts, f.va, f.vb, f.aa, f.ab, f.p0, f.p1, f.vp, f.ap);
        if (n < 7) begin
          f.vp = 0; f.ap = 0;
          n = $sscanf(line, "%s %d %d %d %d %d %d",
                      ts, f.va, f.vb, f.aa, f.ab, f.p0, f.p1);
        end
{% else %}
        n = $sscanf(line, "%s %d %d %d %d %d %d",
                    ts, f.va, f.vb, f.aa, f.ab, f.p0, f.p1);
{% endif %}
        if (n < 1 || ts.substr(0,0) == "#") continue;
        f.t = type_code(ts);
        if (f.t < 0) begin
          $display("FATAL: unknown fault type '%s' (line %0d)", ts, idx);
          $finish;
        end
{% if num_ports == 2 %}
        // DRF is deferred for num_ports=2 (Phase 2 scope, Workstream K) --
        // the idle-cycle-tracking always_ff block is single-port only in
        // this phase. Fails loud here (a real fault list actually asking
        // for it) rather than at codegen time (which cannot know whether
        // any given campaign's fault LIST will ever contain a DRF entry --
        // the registry/type-table always carries T_DRF's type code
        // regardless), and rather than silently no-opping the fault.
        if (f.t == T_DRF) begin
          $display("FATAL: DRF is not yet supported for num_ports=2 (line %0d) -- the idle-cycle tracking always_ff block is single-port only in this phase", idx);
          $finish;
        end
{% endif %}
        if (n < 7) begin
          $display("FATAL: fault line %0d has %0d fields, need 7", idx, n);
          $finish;
        end
        f.hits = 0;
        FQ.push_back(f);
        FNAME.push_back(ts);
        idx++;
      end
      $fclose(fd);

      if (!$value$plusargs("FAULT_INDEX=%d", sel)) sel = -1;
      if (sel >= 0) begin
        if (sel >= FQ.size()) begin
          $display("FATAL: FAULT_INDEX %0d out of range (%0d faults)", sel, FQ.size());
          $finish;
        end
        f = FQ[sel];
        ts = FNAME[sel];
        FQ.delete(); FNAME.delete();
        FQ.push_back(f); FNAME.push_back(ts);
        $display("FAULT_LOADED idx=%0d type=%s v=%0d.%0d a=%0d.%0d p0=%0d p1=%0d",
                 sel, ts, f.va, f.vb, f.aa, f.ab, f.p0, f.p1);
      end else begin
        for (int i = 0; i < FQ.size(); i++)
          $display("FAULT_LOADED idx=%0d type=%s v=%0d.%0d a=%0d.%0d p0=%0d p1=%0d",
                   i, FNAME[i], FQ[i].va, FQ[i].vb, FQ[i].aa, FQ[i].ab, FQ[i].p0, FQ[i].p1);
      end
      // Apply stuck faults to the initial state as well.
      clamp_static();
    end
  end

  // ---------------- static clamps (registry-generated) ----------------
  function automatic void clamp_static();
    foreach (FQ[i]) begin
      case (FQ[i].t)
{% for arm in static_clamp_arms %}
        {{ arm }}
{% endfor %}
        default: ;
      endcase
    end
  endfunction

  function automatic bit dir_match(int p, bit up, bit dn);
    // p: 0 = up (0->1), 1 = down (1->0), 2 = either
    return (p == 2 && (up || dn)) || (p == 0 && up) || (p == 1 && dn);
  endfunction

  // ---------------- write path ----------------
{% if num_ports == 2 %}
  function automatic void write_op(input logic [ADDR_WIDTH-1:0] a,
                                   input logic [DATA_WIDTH-1:0] d,
                                   input logic [DATA_WIDTH-1:0] m,
                                   input int port);
{% else %}
  function automatic void write_op(input logic [ADDR_WIDTH-1:0] a,
                                   input logic [DATA_WIDTH-1:0] d,
                                   input logic [DATA_WIDTH-1:0] m);
{% endif %}
    int ea;
    logic [DATA_WIDTH-1:0] old, nxt;
    ea = int'(a);

    // Address decoder faults act on the whole word (AF_NOACC/AF_ALIAS: fixed,
    // not registry-driven -- see fault_primitives.py module docstring).
    foreach (FQ[i]) begin
      if (FQ[i].va != ea) continue;
      if (FQ[i].t == T_AF_NOACC) begin FQ[i].hits++; return; end        // write reaches no cell
      if (FQ[i].t == T_AF_ALIAS) begin FQ[i].hits++; ea = FQ[i].aa; end // write lands on alias target
    end

    old = mem[ea];
    nxt = old;

    // Per-bit cell write faults on the effective address.
    for (int b = 0; b < DATA_WIDTH; b++) begin
      if (!m[b]) continue;
      nxt[b] = d[b];
      foreach (FQ[i]) begin
        if (FQ[i].va != ea || FQ[i].vb != b) continue;
        case (FQ[i].t)
{% for arm in write_victim_arms %}
          {{ arm }}
{% endfor %}
          T_SOF: begin nxt[b] = old[b]; FQ[i].hits++; end   // cell inaccessible (fixed: see docstring)
          default: ;
        endcase
      end
    end

    mem[ea] = nxt;

    // Aggressor-side coupling triggers caused by this write.
    for (int b = 0; b < DATA_WIDTH; b++) begin
      bit up, dn, nt0, nt1;
      if (!m[b]) continue;
      up  = (old[b] == 1'b0) && (nxt[b] == 1'b1);
      dn  = (old[b] == 1'b1) && (nxt[b] == 1'b0);
      nt0 = (old[b] == 1'b0) && (d[b]   == 1'b0);   // attempted non-transition w0
      nt1 = (old[b] == 1'b1) && (d[b]   == 1'b1);   // attempted non-transition w1
      foreach (FQ[i]) begin
{% if num_ports == 2 %}
        if (FQ[i].aa != ea || FQ[i].ab != b || FQ[i].ap != port) continue;
{% else %}
        if (FQ[i].aa != ea || FQ[i].ab != b) continue;
{% endif %}
        case (FQ[i].t)
{% for arm in write_aggressor_arms %}
          {{ arm }}
{% endfor %}
          T_CFDS: if ((FQ[i].p0 == 2 && nt0) || (FQ[i].p0 == 3 && nt1)) begin   // fixed: see docstring
                    mem[FQ[i].va][FQ[i].vb] = ~mem[FQ[i].va][FQ[i].vb];
                    FQ[i].hits++;
                  end
          default: ;
        endcase
      end
    end

    // Half-select disturb (HSD, Workstream L): a write to any OTHER address
    // sharing the victim's physical row forces the victim toward FQ[i].p0
    // (the disturbed-toward polarity), not an invert -- see fault_ram.sv's
    // identical check for the full rationale (kept in sync manually). A
    // SINGLE per-fault, per-word check -- deliberately NOT nested in either
    // per-bit loop above, and fires regardless of this write's own `m` (word-
    // line assertion is per-WORD, independent of which bits are masked).
    // Port-agnostic by construction (only `ea`/FQ[i].va matter, not `port`):
    // under num_ports==2 this function already runs once per port against
    // the SAME shared mem[]/FQ[], so "physical row shared across both ports"
    // falls out for free with no separate num_ports==2 branch needed here.
    foreach (FQ[i]) begin
      if (FQ[i].t != T_HSD) continue;
      if (ea == FQ[i].va) continue;                                       // direct write to the victim itself
      if ((ea / WORDS_PER_ROW) != (FQ[i].va / WORDS_PER_ROW)) continue;    // different physical row
      if (mem[FQ[i].va][FQ[i].vb] != FQ[i].p0[0]) begin
        mem[FQ[i].va][FQ[i].vb] = FQ[i].p0[0];
        FQ[i].hits++;
      end
    end

    clamp_static();
  endfunction

  // ---------------- read path ----------------
{% if num_ports == 2 %}
  function automatic logic [DATA_WIDTH-1:0] read_op(input logic [ADDR_WIDTH-1:0] a, input int port);
{% else %}
  function automatic logic [DATA_WIDTH-1:0] read_op(input logic [ADDR_WIDTH-1:0] a);
{% endif %}
    int ea;
    logic [DATA_WIDTH-1:0] old, rv;
    ea = int'(a);

    foreach (FQ[i]) begin
      if (FQ[i].va != ea) continue;
      if (FQ[i].t == T_AF_NOACC) begin
        FQ[i].hits++;
        return {DATA_WIDTH{FQ[i].p0[0]}};   // undriven read returns fixed value p0
      end
      if (FQ[i].t == T_AF_ALIAS) begin FQ[i].hits++; ea = FQ[i].aa; end
    end

    clamp_static();       // static-clamp state must be visible before the read
    old = mem[ea];
    rv  = old;

    for (int b = 0; b < DATA_WIDTH; b++) begin
      foreach (FQ[i]) begin
        if (FQ[i].va != ea || FQ[i].vb != b) continue;
        case (FQ[i].t)
{% for arm in read_victim_arms %}
          {{ arm }}
{% endfor %}
{% if num_ports == 2 %}
          T_SOF: begin rv[b] = (port == 0) ? dout0[b] : dout1[b]; FQ[i].hits++; end   // output keeper (fixed, per-port)
{% else %}
          T_SOF: begin rv[b] = dout[b]; FQ[i].hits++; end   // output keeper returns stale data (fixed)
{% endif %}
          default: ;
        endcase
      end
    end

    // Read-triggered coupling disturbs (CFDS: fixed, see docstring).
    for (int b = 0; b < DATA_WIDTH; b++) begin
      foreach (FQ[i]) begin
{% if num_ports == 2 %}
        if (FQ[i].t != T_CFDS || FQ[i].aa != ea || FQ[i].ab != b || FQ[i].ap != port) continue;
{% else %}
        if (FQ[i].t != T_CFDS || FQ[i].aa != ea || FQ[i].ab != b) continue;
{% endif %}
        if ((FQ[i].p0 == 0 && old[b] == 1'b0) ||
            (FQ[i].p0 == 1 && old[b] == 1'b1) ||
            (FQ[i].p0 == 4)) begin
          mem[FQ[i].va][FQ[i].vb] = ~mem[FQ[i].va][FQ[i].vb];
          FQ[i].hits++;
        end
      end
    end

    clamp_static();
    return rv;
  endfunction

  // ---------------- port behavior ----------------
{% if num_ports == 2 %}
  always @(posedge clk0) begin
    if (!csb0) begin
      if (!web0) write_op(addr0, din0, wmask0, 0);
      else       dout0 <= read_op(addr0, 0);
    end
  end

  always @(posedge clk1) begin
    if (!csb1) begin
      if (!web1) write_op(addr1, din1, wmask1, 1);
      else       dout1 <= read_op(addr1, 1);
    end
  end
{% else %}
  always @(posedge clk) begin
    if (!csb) begin
      if (!web) write_op(addr, din, wmask);
      else      dout <= read_op(addr);
    end
  end

  // ---------------- Data Retention Fault (DRF) idle-cycle tracking ----------------
  // Single-port only in this phase (num_ports=2 is rejected loudly above, at
  // fault-list-load time). See src/autombist/engine/fault_ram.sv's identical
  // block for the full race-condition analysis and design rationale -- KEPT
  // IN SYNC MANUALLY with that file, no automated equivalence check exists.
  int drf_idle_count = 0;
  bit drf_corrupted  = 0;
  int drf_hits = 0;

  always_ff @(posedge clk) begin
    if (FQ.size() > 0 && FQ[0].t == T_DRF) begin
      if (!csb && !web && int'(addr) == FQ[0].va) begin
        drf_idle_count <= 0;
        drf_corrupted  <= 0;
      end else if (!drf_corrupted) begin
        if (drf_idle_count >= FQ[0].p0) begin
          mem[FQ[0].va][FQ[0].vb] <= ~mem[FQ[0].va][FQ[0].vb];
          drf_hits      <= drf_hits + 1;
          drf_corrupted <= 1;
        end else begin
          drf_idle_count <= drf_idle_count + 1;
        end
      end
    end
  end
{% endif %}

  final begin
    if ($test$plusargs("FAULT_VERBOSE"))
      foreach (FQ[i])
{% if num_ports == 2 %}
        $display("FAULT_HITS idx=%0d type=%s activations=%0d", i, FNAME[i], FQ[i].hits);
{% else %}
        // DRF's activation count lives in the dedicated drf_hits counter
        // (see the idle-cycle-tracking always_ff block), not FQ[i].hits.
        // Only FQ[0] is ever tracked by that block, so a DRF entry at any
        // other index is structurally inert and must report 0, not
        // drf_hits (see fault_ram.sv's identical fix for why).
        $display("FAULT_HITS idx=%0d type=%s activations=%0d",
                 i, FNAME[i], (FQ[i].t == T_DRF) ? (i == 0 ? drf_hits : 0) : FQ[i].hits);
{% endif %}
  end

endmodule
