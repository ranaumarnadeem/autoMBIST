`timescale 1ns/1ps
// Auto-generated by autombist (add_fsm) -- validates a researcher's MBIST
// controller FSM against the fault-campaign engine (openram_shim -> fault_ram).
// Detection is bist_fail only: no elem/op attribution, since a black-box
// controller does not expose an algorithm's internal step counter.

module {{ harness_top }} #(
  parameter int AW = {{ addr_width }},
  parameter int DW = {{ data_width }}
);

  logic clk = 0;
  logic rst_n;
  logic bist_start;
  logic bist_busy;   // optional per the FSM port contract; connected but unused here
  logic bist_done;
  logic bist_fail;

  logic          sram_clk0;
  logic          sram_csb0;
  logic          sram_web0;
  logic [AW-1:0] sram_addr0;
  logic [DW-1:0] sram_din0;
  logic [DW-1:0] sram_dout0;

  always #5 clk = ~clk;

  // A broken/misbehaving FSM (e.g. one that never asserts bist_done) must not
  // hang the campaign forever. March SS (the most expensive built-in, 22n)
  // needs about 22*depth cycles; this leaves generous headroom.
  localparam int WATCHDOG_CYCLES = 64 * (1 << AW) + 10000;
  integer watchdog_cycles = 0;
  always @(posedge clk) begin
    watchdog_cycles = watchdog_cycles + 1;
    if (watchdog_cycles > WATCHDOG_CYCLES) begin
      $display("WATCHDOG: bist_done never asserted after %0d cycles", watchdog_cycles);
      $finish;
    end
  end
{% if emit_seq_trace %}
  // Sequence-correctness observer (opt-in). When +SEQ_TRACE is passed, print one
  // ACCESS line per committed memory operation (chip-select active at a clock
  // edge -- one op per edge, since the controller de-asserts csb between ops).
  // The campaign parses these from the GOLDEN pass to confirm the controller
  // drives exactly the march sequence its spec requires, independent of fault
  // detection (see autombist.seq_check). Emits nothing unless +SEQ_TRACE is set,
  // so a fault run's output is unchanged.
  bit seq_trace = 0;
  initial seq_trace = ($test$plusargs("SEQ_TRACE") != 0);
  always @(posedge clk) begin
    if (seq_trace && sram_csb0 == 1'b0)
      $display("ACCESS port=0 we=%0d addr=%0d din=%0h", ~sram_web0, sram_addr0, sram_din0);
  end
{% endif %}

  {{ fsm_module_name }} #(
    .ADDR_WIDTH(AW),
    .DATA_WIDTH(DW)
  ) dut (
    .clk(clk),
    .rst_n(rst_n),
    .bist_start(bist_start),
{% if has_bist_busy %}
    .bist_busy(bist_busy),
{% endif %}
    .bist_done(bist_done),
    .bist_fail(bist_fail),
    .sram_clk0(sram_clk0),
    .sram_csb0(sram_csb0),
    .sram_web0(sram_web0),
    .sram_addr0(sram_addr0),
    .sram_din0(sram_din0),
    .sram_dout0(sram_dout0)
  );

  openram_shim #(
    .DATA_WIDTH(DW),
    .ADDR_WIDTH(AW),
    .NUM_WMASKS(1)
  ) shim (
    .clk0(sram_clk0),
    .csb0(sram_csb0),
    .web0(sram_web0),
    .wmask0(1'b1),
    .addr0(sram_addr0),
    .din0(sram_din0),
    .dout0(sram_dout0)
  );

  initial begin
    rst_n = 0;
    bist_start = 0;
    repeat (4) @(negedge clk);
    rst_n = 1;
    repeat (2) @(negedge clk);
    bist_start = 1;
    // Clear on the following NEGEDGE, not @(posedge clk); clearing at the same
    // posedge the FSM's always_ff samples bist_start races against that
    // sampling (simulator-scheduling-dependent) and can silently drop the
    // start pulse, leaving the FSM stuck in its idle state forever.
    @(negedge clk);
    bist_start = 0;

    wait (bist_done === 1'b1);
    @(negedge clk);

    if (bist_fail)
      $display("RESULT DETECTED alg=FSM elem=0 op=0 addr=0 xor=0");
    else
      $display("RESULT ESCAPED alg=FSM");
    $finish;
  end

endmodule
