#!/usr/bin/env bash
# Auto-generated by autombist — grade the MBIST controller logic with FaultFlow.
#
# Runs standalone (re-runnable / CI-friendly):
#   FAULTFLOW_HOME=/path/to/faultflow bash run_faultflow.sh
# Optional overrides: FF_PYTHON=... YOSYS=...
set -euo pipefail

FAULTFLOW_HOME="${FAULTFLOW_HOME:-{{ repo }}}"
FF_PY="${FF_PYTHON:-{{ ff_python }}}"
YOSYS="${YOSYS:-{{ yosys }}}"
TOP="{{ top }}"
OFS="{{ ofs }}"
JSON="{{ json_out }}"

echo "[autombist] (1/4) synthesizing collar (memory {{ memory_instances }} blackboxed)..."
"$YOSYS" -q -s "{{ synth }}"

echo "[autombist] (2/4) verifying the memory instance(s) survived flatten..."
"$FF_PY" - "$JSON" "$TOP" "{{ memory_name }}" {{ memory_instances }} <<'PYEOF'
import json, sys
mods = json.load(open(sys.argv[1]))["modules"]
cells = mods.get(sys.argv[2], {}).get("cells", {})
missing = [inst for inst in sys.argv[4:]
           if not (inst in cells and cells[inst].get("type") == sys.argv[3])]
if missing:
    sys.exit("ERROR: blackbox instance(s) %s were flattened away -- controller grading would be meaningless" % missing)
print("[autombist]   OK: all blackbox memory cells present in netlist")
PYEOF

echo "[autombist] (3/4) running FaultFlow scan stuck-at ATPG..."
cd "$FAULTFLOW_HOME"
"$FF_PY" ff.py init --top "$TOP" -c "$OFS"
"$FF_PY" ff.py scan --top "$TOP" -c "$OFS"
"$FF_PY" ff.py sim  --top "$TOP" -c "$OFS" --scan

echo "[autombist] (4/4) controller structural coverage:"
"$FF_PY" - "$FAULTFLOW_HOME/output/$TOP/.faultflow/intermediate/coverage_report.json" <<'PYEOF'
import json, sys
s = json.load(open(sys.argv[1]))["summary"]
print("  coverage=%.2f%%  detected=%s  denom=%s  excluded_blackbox=%s"
      % (s.get("coverage_percent", 0.0), s.get("detected"), s.get("denominator"), s.get("excluded_blackbox")))
PYEOF
