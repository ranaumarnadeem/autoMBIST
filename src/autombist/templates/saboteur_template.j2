    logic [DATA_WIDTH-1:0]  pend_tgt  [0:MAX_PEND-1];
    logic [DELAY_CNT_W-1:0] pend_cnt  [0:MAX_PEND-1];
    logic                   pend_val  [0:MAX_PEND-1];
    integer idx;
    integer p;
